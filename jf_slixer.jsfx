desc:jf_slixer - transient slicer / pad sampler
//tags: sampler slicer drums
//author: jeeruff

options:maxmem=16777216
options:gmem=jf_slixer

slider1:sens=0.50<0.05,1,0.01>Transient sensitivity
slider2:basenote=36<0,96,1>Base MIDI note
slider3:monomode=0<0,1,1{Poly,Mono}>Voice mode
slider4:legato=0<0,1,1{Off,On}>Legato
slider5:glide_ms=0<0,500,1>Glide (ms)
slider6:interp=2<0,2,1{None,Linear,Hermite}>Interpolation
slider7:gatemode=0<0,1,1{One-shot,Gate}>Trigger mode
slider8:mgain_db=0<-24,12,0.1>Master gain (dB)
slider9:caplen=8<1,120,1>Max capture (s)
slider10:saveaudio=1<0,1,1{No,Yes}>Save audio in project
slider11:thru=1<0,1,1{Off,On}>Input passthrough

in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init
ext_noinit = 1;
ext_midi_bus = 1;

MAXSL   = 64;
NVOICE  = 16;
VF      = 32;
MAGIC   = 8888123;

// memory map
qoff    = 3000;               // pending note-off queue, 32*3
SLBASE  = 4096;               // 14 contiguous tables of 64
sl_start = SLBASE;
sl_end   = SLBASE + 64;
sl_pitch = SLBASE + 128;
sl_gain  = SLBASE + 192;
sl_pan   = SLBASE + 256;
sl_fx    = SLBASE + 320;
sl_amt   = SLBASE + 384;
sl_p2    = SLBASE + 448;
sl_choke = SLBASE + 512;
sl_class = SLBASE + 576;
sl_mout  = SLBASE + 640;
sl_mnum  = SLBASE + 704;
sl_mchan = SLBASE + 768;
sl_mbus  = SLBASE + 832;
voices  = 8192;               // 16 * 32
OVW     = 24576;              // overview bins (min,max), 256 frames/bin
BUF     = 131072;             // stereo interleaved
BUFMAXFR = (16777216 - BUF) / 2;
BINSZ   = 256;

// voice fields
fA=0; fS=1; fPOS=2; fRATE=3; fTR=4; fENV=5; fST=6; fGL=7; fGR=8; fNOTE=9;
fVT=10; fPA=11; fPB=12; fPHA=13; fPHB=14; fBCC=15; fBHL=16; fBHR=17;
fPH1=18; fCEN=19; fEND=20; fVEL=21; fONOTE=22; fOCH=23; fOBUS=24;

!initdone ? (
  initdone = 1;
  sel = -1;
  pv_req = -1;
  fld_active = -1;
  task = 0;
  cap_srate = srate;
);

function slice_defaults(i) (
  sl_pitch[i]=0; sl_gain[i]=0; sl_pan[i]=0;
  sl_fx[i]=0; sl_amt[i]=0.5; sl_p2[i]=0.5;
  sl_choke[i]=0; sl_class[i]=0;
  sl_mout[i]=0; sl_mnum[i]=36+i; sl_mchan[i]=0; sl_mbus[i]=0;
);

function sort_slices() local(i j k p t) (
  i = 1;
  while (i < nsl) (
    j = i;
    while (j > 0 && sl_start[j-1] > sl_start[j]) (
      k = 0;
      while (k < 14) (
        p = SLBASE + k*64 + j;
        t = p[-1]; p[-1] = p[0]; p[0] = t;
        k += 1;
      );
      j -= 1;
    );
    i += 1;
  );
);

function calc_ends() local(i) (
  sort_slices();
  i = 0;
  while (i < nsl) (
    sl_end[i] = i < nsl-1 ? sl_start[i+1] : capframes;
    i += 1;
  );
);

function del_slice(idx) local(j k p) (
  j = idx;
  while (j < nsl-1) (
    k = 0;
    while (k < 14) (
      p = SLBASE + k*64 + j;
      p[0] = p[1];
      k += 1;
    );
    j += 1;
  );
  nsl -= 1;
  sel >= nsl ? sel = nsl-1;
  calc_ends();
);

function add_slice(fr) local(i) (
  nsl < MAXSL && capframes > 0 ? (
    fr = max(0, min(capframes-64, floor(fr)));
    sl_start[nsl] = fr;
    slice_defaults(nsl);
    nsl += 1;
    calc_ends();
    i = 0; sel = 0;
    while (i < nsl) ( sl_start[i] == fr ? sel = i; i += 1; );
  );
);

function import_markers() local(n i p) (
  n = min(gmem[2], MAXSL);
  capframes > 0 && n > 0 ? (
    nsl = 0;
    i = 0;
    while (i < n) (
      p = floor(gmem[8+i] * cap_srate);
      p >= 0 && p < capframes ? (
        sl_start[nsl] = p;
        slice_defaults(nsl);
        nsl += 1;
      );
      i += 1;
    );
    calc_ends();
    sel = nsl > 0 ? 0 : -1;
  );
);

function qpush(v) (
  qn < 32 ? (
    q = qoff + qn*3;
    q[0] = v[fOBUS]; q[1] = v[fOCH]; q[2] = v[fONOTE]-1;
    qn += 1;
  );
  v[fONOTE] = 0;
);

function readsmp(pos ch) local(i f a b c d c1 c2 c3) (
  pos < 1 ? pos = 1;
  pos > capframes-3 ? pos = capframes-3;
  interp < 0.5 ? (
    BUF[floor(pos+0.5)*2+ch];
  ) : interp < 1.5 ? (
    i = floor(pos); f = pos - i;
    a = BUF[i*2+ch];
    a + (BUF[i*2+2+ch] - a) * f;
  ) : (
    i = floor(pos); f = pos - i;
    a = BUF[(i-1)*2+ch]; b = BUF[i*2+ch];
    c = BUF[(i+1)*2+ch]; d = BUF[(i+2)*2+ch];
    c1 = 0.5*(c-a);
    c2 = a - 2.5*b + 2*c - 0.5*d;
    c3 = 0.5*(d-a) + 1.5*(b-c);
    ((c3*f + c2)*f + c1)*f + b;
  );
);

function trigger_slice(s vel note ofs) local(vi v cg tr vol pl pr leg was best bi) (
  s >= 0 && s < nsl && capframes > 0 && sl_start[s] < sl_end[s] ? (
    cg = sl_choke[s];
    cg ? (
      vi = 0;
      while (vi < NVOICE) (
        v = voices + vi*VF;
        v[fA] && sl_choke[v[fS]] == cg ? v[fST] = 3;
        vi += 1;
      );
    );
    monomode ? (
      vi = 0;
    ) : (
      bi = -1; best = 2; vi = 0;
      while (vi < NVOICE) (
        v = voices + vi*VF;
        v[fA] == 0 ? ( bi = vi; vi = NVOICE; )
        : ( v[fENV] <= best ? ( best = v[fENV]; bi = vi; ); vi += 1; );
      );
      vi = bi;
    );
    v = voices + vi*VF;
    v[fA] && v[fONOTE] ? qpush(v);
    was = v[fA] && v[fST] != 3;
    leg = monomode && legato && was;
    tr = pow(2, sl_pitch[s]/12) * (cap_srate > 0 ? cap_srate/srate : 1);
    v[fTR] = tr;
    v[fRATE] = (monomode && glide_ms > 0 && was) ? v[fRATE] : tr;
    v[fS] = s; v[fEND] = sl_end[s];
    v[fPOS] = sl_start[s]; v[fVT] = sl_start[s];
    v[fPA] = sl_start[s]; v[fPB] = sl_start[s];
    v[fPHA] = 0; v[fPHB] = 0.5;
    leg ? 0 : (
      v[fENV] = v[fA] ? v[fENV] : 0;
      v[fST] = 1;
    );
    vol = pow(10, sl_gain[s]/20) * (vel/127);
    pl = min(1, 1 - sl_pan[s]); pr = min(1, 1 + sl_pan[s]);
    v[fGL] = vol*pl; v[fGR] = vol*pr;
    v[fBCC] = 0; v[fBHL] = 0; v[fBHR] = 0; v[fPH1] = 0; v[fCEN] = 0;
    v[fNOTE] = note; v[fVEL] = vel;
    v[fA] = 1;
    sl_mout[s] == 1 ? (
      midi_bus = sl_mbus[s];
      midisend(ofs, $x90 | sl_mchan[s], sl_mnum[s], vel);
      v[fONOTE] = sl_mnum[s]+1; v[fOCH] = sl_mchan[s]; v[fOBUS] = sl_mbus[s];
    ) : sl_mout[s] == 2 ? (
      midi_bus = sl_mbus[s];
      midisend(ofs, $xB0 | sl_mchan[s], sl_mnum[s], vel);
      v[fONOTE] = 0;
    ) : v[fONOTE] = 0;
    last_trig = s;
  );
);

function release_note(note) local(vi v) (
  gatemode ? (
    vi = 0;
    while (vi < NVOICE) (
      v = voices + vi*VF;
      v[fA] && v[fNOTE] == note ? v[fST] = 3;
      vi += 1;
    );
  );
);

function kill_all() local(vi v) (
  vi = 0;
  while (vi < NVOICE) (
    v = voices + vi*VF;
    v[fA] ? v[fST] = 3;
    vi += 1;
  );
);

function finish_capture() local(b) (
  capturing = 0; armed = 0;
  capframes = wr;
  cap_srate = srate;
  wr > 0 && (wr & (BINSZ-1)) ? (
    b = floor(wr/BINSZ);
    OVW[b*2] = binmin; OVW[b*2+1] = binmax;
  );
  nsl > 0 ? calc_ends();
);

@slider

@block
// derived coefs (cheap; also covers footer-UI edits of slider vars)
mvol = pow(10, mgain_db/20);
gcoef = glide_ms <= 0 ? 1 : 1 - exp(-1/(glide_ms * 0.001 * srate));
atk_inc = 1 / max(1, 0.0015*srate);
rel_c = exp(-1/(0.004*srate));

// flush pending note-offs from voices that ended in @sample
qi = 0;
while (qi < qn) (
  q = qoff + qi*3;
  midi_bus = q[0];
  midisend(0, $x80 | q[1], q[2], 0);
  qi += 1;
);
qn = 0;

// auto-import take markers published by the Lua bridge
gmem[0] == MAGIC && gmem[1] != g_serial ? (
  g_serial = gmem[1];
  !capturing ? import_markers();
);

// pad preview from UI
pv_req >= 0 ? (
  trigger_slice(pv_req, 100, -1, 0);
  pv_req = -1;
);

while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & $xF0;
  st == $x90 && m3 > 0 ? (
    trigger_slice(m2 - basenote, m3, m2, ofs);
    midi_act = 1;
  ) : (st == $x80 || (st == $x90 && m3 == 0)) ? (
    release_note(m2);
  ) : st == $xB0 && (m2 == 123 || m2 == 120) ? (
    kill_all();
  );
  midisend(ofs, m1, m2, m3);
);

@sample
// capture
armed ? (
  !capturing ? (
    (play_state & 1) || (abs(spl0) + abs(spl1) > 0.001) ? (
      capturing = 1; wr = 0;
      binmin = 1; binmax = -1;
    );
  );
  capturing ? (
    maxfr = min(BUFMAXFR, caplen * srate);
    wr < maxfr ? (
      BUF[wr*2] = spl0; BUF[wr*2+1] = spl1;
      cm = (spl0 + spl1) * 0.5;
      cm > binmax ? binmax = cm;
      cm < binmin ? binmin = cm;
      (wr & (BINSZ-1)) == (BINSZ-1) ? (
        OVW[floor(wr/BINSZ)*2] = binmin;
        OVW[floor(wr/BINSZ)*2+1] = binmax;
        binmin = 1; binmax = -1;
      );
      wr += 1;
    ) : (
      finish_capture();
    );
  );
);

outl = 0; outr = 0;
vi = 0;
while (vi < NVOICE) (
  v = voices + vi*VF;
  v[fA] ? (
    s = v[fS];
    fx = sl_fx[s];
    amt = sl_amt[s]; p2 = sl_p2[s];
    v[fRATE] += (v[fTR] - v[fRATE]) * gcoef;
    rt = v[fRATE];

    fx == 2 ? (
      // granular stretch: 2 hann-windowed heads, timeline independent of pitch
      spd = pow(4, 1 - 2*amt) * (cap_srate > 0 ? cap_srate/srate : 1);
      glen = (0.02 + p2*0.1) * srate;
      v[fVT] += spd;
      v[fPA] += rt; v[fPB] += rt;
      v[fPHA] += 1/glen; v[fPHB] += 1/glen;
      v[fPHA] >= 1 ? ( v[fPHA] -= 1; v[fPA] = v[fVT]; );
      v[fPHB] >= 1 ? ( v[fPHB] -= 1; v[fPB] = v[fVT]; );
      wa = 0.5 - 0.5*cos(2*$pi*v[fPHA]);
      wb = 0.5 - 0.5*cos(2*$pi*v[fPHB]);
      l = readsmp(v[fPA],0)*wa + readsmp(v[fPB],0)*wb;
      r = readsmp(v[fPA],1)*wa + readsmp(v[fPB],1)*wb;
      v[fVT] >= v[fEND] ? v[fST] = 3;
    ) : fx == 4 ? (
      // FM of playback position
      frq = 30 * pow(2, p2*7);
      v[fPH1] += frq/srate * 2*$pi;
      mp = v[fPOS] + sin(v[fPH1]) * amt*amt*400;
      l = readsmp(mp,0); r = readsmp(mp,1);
      v[fPOS] += rt;
      v[fPOS] >= v[fEND] ? v[fST] = 3;
    ) : (
      l = readsmp(v[fPOS],0); r = readsmp(v[fPOS],1);
      v[fPOS] += rt;
      v[fPOS] >= v[fEND] ? v[fST] = 3;
    );

    fx == 1 ? (
      // bitcrush: amt=depth, p2=rate divide
      v[fBCC] -= 1;
      v[fBCC] <= 0 ? (
        v[fBCC] = 1 + floor(p2*31);
        qz = pow(2, 15 - amt*14);
        v[fBHL] = floor(l*qz + 0.5)/qz;
        v[fBHR] = floor(r*qz + 0.5)/qz;
      );
      l = v[fBHL]; r = v[fBHR];
    ) : fx == 3 ? (
      // compressor: amt=amount, p2=release
      ain = max(abs(l), abs(r));
      ain > v[fCEN] ? v[fCEN] += (ain - v[fCEN])*0.15
                    : v[fCEN] *= exp(-1/((0.03 + p2*0.5)*srate));
      cg = v[fCEN] > 0.1 ? pow(v[fCEN]/0.1, -0.8*amt) : 1;
      cg *= 1 + amt*2.5;
      l *= cg; r *= cg;
    ) : fx == 5 ? (
      // AM/tremolo: amt=depth, p2=rate
      frq = 0.5 * pow(2, p2*11);
      v[fPH1] += frq/srate * 2*$pi;
      cg = 1 - amt*(0.5 + 0.5*sin(v[fPH1]));
      l *= cg; r *= cg;
    ) : fx == 6 ? (
      // ringmod: amt=mix, p2=freq
      frq = 30 * pow(2, p2*7);
      v[fPH1] += frq/srate * 2*$pi;
      rm = sin(v[fPH1]);
      l = l*(1-amt) + l*rm*amt;
      r = r*(1-amt) + r*rm*amt;
    ) : fx == 7 ? (
      // saturator: amt=drive, p2=tone
      dv = 1 + amt*24;
      l = l*dv/(1 + abs(l*dv));
      r = r*dv/(1 + abs(r*dv));
      tc = 1 - exp(-2*$pi*(200 + p2*p2*18000)/srate);
      v[fBHL] += (l - v[fBHL])*tc;
      v[fBHR] += (r - v[fBHR])*tc;
      l = v[fBHL]; r = v[fBHR];
    );

    v[fST] == 1 ? (
      v[fENV] += atk_inc;
      v[fENV] >= 1 ? ( v[fENV] = 1; v[fST] = 2; );
    ) : v[fST] == 3 ? (
      v[fENV] *= rel_c;
      v[fENV] < 0.001 ? (
        v[fA] = 0;
        v[fONOTE] ? qpush(v);
      );
    );
    outl += l * v[fENV] * v[fGL];
    outr += r * v[fENV] * v[fGR];
  );
  vi += 1;
);

spl0 = spl0*thru + outl*mvol;
spl1 = spl1*thru + outr*mvol;

@serialize
file_var(0, capframes);
file_var(0, cap_srate);
file_var(0, nsl);
file_var(0, sel);
file_mem(0, SLBASE, 14*64);
srz_read = file_avail(0) >= 0;
!srz_read ? ( audioflag = saveaudio && capframes > 0 ? 1 : 0; );
file_var(0, audioflag);
audioflag ? file_mem(0, BUF, capframes*2);
srz_read ? (
  cap_srate <= 0 ? cap_srate = srate;
  capframes > 0 ? ( task = 3; ov_i = 0; );  // rebuild overview chunked in @gfx
);

@gfx 760 480

function fxname(i dst) (
  i==0 ? strcpy(dst,"OFF") : i==1 ? strcpy(dst,"CRUSH") : i==2 ? strcpy(dst,"STRETCH") :
  i==3 ? strcpy(dst,"COMP") : i==4 ? strcpy(dst,"FM") : i==5 ? strcpy(dst,"AM") :
  i==6 ? strcpy(dst,"RING") : strcpy(dst,"SAT");
);
function classname(i dst) (
  i==0 ? strcpy(dst,"-") : i==1 ? strcpy(dst,"KICK") : i==2 ? strcpy(dst,"SNARE") :
  i==3 ? strcpy(dst,"HAT") : i==4 ? strcpy(dst,"PERC") : strcpy(dst,"CRASH");
);
function classcol(i) (
  i==1 ? gfx_set(0.95,0.45,0.30,1) :
  i==2 ? gfx_set(0.95,0.85,0.35,1) :
  i==3 ? gfx_set(0.40,0.85,0.95,1) :
  i==4 ? gfx_set(0.50,0.90,0.50,1) :
  i==5 ? gfx_set(0.90,0.45,0.90,1) :
         gfx_set(0.62,0.62,0.62,1);
);
function moutname(i dst) (
  i==0 ? strcpy(dst,"OFF") : i==1 ? strcpy(dst,"NOTE") : strcpy(dst,"CC");
);

function btn(x y w h lab on) local(hit r) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  on ? gfx_set(0.85,0.35,0.30,1) : hit ? gfx_set(0.32,0.34,0.38,1) : gfx_set(0.24,0.26,0.29,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.5,0.52,0.55,1);
  gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1); gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  gfx_set(0.92,0.93,0.94,1);
  gfx_measurestr(lab, tw, th);
  gfx_x = x + (w-tw)/2; gfx_y = y + (h-th)/2;
  gfx_drawstr(lab);
  r = hit && lclick;
  r;
);

function ufield(id x y w h lo hi def isenum val lab disp) local(hit nv tw th) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  hit && lclick ? (
    dbl ? (
      val = def;
    ) : isenum ? (
      val = val+1 > hi ? lo : val+1;
    ) : (
      fld_active = id; fld_v0 = val; fld_y0 = mouse_y;
    );
  );
  fld_active == id && (mouse_cap & 1) ? (
    nv = fld_v0 + (fld_y0 - mouse_y) * (hi-lo) / 160 * ((mouse_cap & 4) ? 0.1 : 1);
    val = min(hi, max(lo, nv));
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  fld_active == id ? gfx_set(0.30,0.36,0.44,1) : gfx_set(0.22,0.24,0.27,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.42,0.44,0.48,1);
  gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1); gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  gfx_set(0.55,0.58,0.62,1);
  gfx_x = x+4; gfx_y = y+2;
  gfx_drawstr(lab);
  gfx_set(0.93,0.94,0.95,1);
  gfx_measurestr(disp, tw, th);
  gfx_x = x + w - tw - 4; gfx_y = y + h - th - 2;
  gfx_drawstr(disp);
  val;
);

gfx_setfont(1, "Arial", 12);
W = gfx_w; H = gfx_h;

// click edges + double-click
lclick = (mouse_cap & 1) && !(last_cap & 1);
lrelease = !(mouse_cap & 1) && (last_cap & 1);
rclick = (mouse_cap & 2) && !(last_cap & 2);
dbl = 0;
lclick ? (
  tnow = time_precise();
  (tnow - lc_time < 0.32 && abs(mouse_x - lc_x) < 5 && abs(mouse_y - lc_y) < 5) ? dbl = 1;
  lc_time = tnow; lc_x = mouse_x; lc_y = mouse_y;
);

// ------- background chunked tasks (detect / classify / overview) -------
task == 1 ? ( // transient detect
  det_new ? (
    det_new = 0; nsl = 0;
    det_i = 0; det_env = 0; det_slow = 0.001;
    det_last = -srate;
    det_gap = floor(0.05 * cap_srate);
    det_fast = exp(-1/(0.003*cap_srate));
    det_slowc = 1 - exp(-1/(0.08*cap_srate));
    det_thr = 1.2 + (1 - sens) * 6;
  );
  det_n = min(det_i + 262144, capframes);
  while (det_i < det_n) (
    dx = abs(BUF[det_i*2]) + abs(BUF[det_i*2+1]);
    det_env = max(dx, det_env * det_fast);
    det_slow += (det_env - det_slow) * det_slowc;
    (det_env > det_slow * det_thr && det_env > 0.01 &&
     det_i - det_last > det_gap && nsl < MAXSL) ? (
      sl_start[nsl] = max(0, det_i - 32);
      slice_defaults(nsl);
      nsl += 1;
      det_last = det_i;
      det_slow = det_env;
    );
    det_i += 1;
  );
  det_i >= capframes ? (
    calc_ends();
    sel = nsl > 0 ? 0 : -1;
    task = 0;
  );
) : task == 2 ? ( // classify slices
  cls_new ? (
    cls_new = 0; cls_s = 0; cls_inslice = 0;
  );
  cls_s >= nsl ? task = 0 : (
    !cls_inslice ? (
      cls_inslice = 1;
      cls_i = sl_start[cls_s];
      cls_lp = 0; cls_lp2 = 0;
      cls_el = 0; cls_eh = 0; cls_et = 1e-9;
      cls_peak = 1e-9; cls_lastloud = sl_start[cls_s];
      cls_klo = 1 - exp(-2*$pi*180/cap_srate);
      cls_khi = 1 - exp(-2*$pi*4500/cap_srate);
    );
    cls_n = min(cls_i + 262144, sl_end[cls_s]);
    while (cls_i < cls_n) (
      cmm = (BUF[cls_i*2] + BUF[cls_i*2+1]) * 0.5;
      cls_lp += (cmm - cls_lp) * cls_klo;
      cls_lp2 += (cmm - cls_lp2) * cls_khi;
      chh = cmm - cls_lp2;
      cls_el += cls_lp*cls_lp;
      cls_eh += chh*chh;
      cls_et += cmm*cmm;
      caa = abs(cmm);
      caa > cls_peak ? cls_peak = caa;
      caa > cls_peak * 0.05 ? cls_lastloud = cls_i;
      cls_i += 1;
    );
    cls_i >= sl_end[cls_s] ? (
      rl = cls_el / cls_et;
      rh = cls_eh / cls_et;
      dlen = (cls_lastloud - sl_start[cls_s]) / cap_srate;
      cc = rl > 0.4 ? 1 :
           (rh > 0.45 && dlen < 0.18) ? 3 :
           (rh > 0.35 && dlen > 0.35) ? 5 :
           (rh < 0.45 && rl < 0.4 && dlen < 0.45) ? 2 : 4;
      sl_class[cls_s] = cc;
      cc == 3 ? sl_choke[cls_s] = 1;  // hats auto-choke
      cls_inslice = 0;
      cls_s += 1;
    );
  );
) : task == 3 ? ( // rebuild overview after project load
  ov_n = min(ov_i + 262144, capframes);
  while (ov_i < ov_n) (
    (ov_i & (BINSZ-1)) == 0 ? ( ovmin = 1; ovmax = -1; );
    cmm = (BUF[ov_i*2] + BUF[ov_i*2+1]) * 0.5;
    cmm > ovmax ? ovmax = cmm;
    cmm < ovmin ? ovmin = cmm;
    ((ov_i & (BINSZ-1)) == (BINSZ-1) || ov_i == capframes-1) ? (
      OVW[floor(ov_i/BINSZ)*2] = ovmin;
      OVW[floor(ov_i/BINSZ)*2+1] = ovmax;
    );
    ov_i += 1;
  );
  ov_i >= capframes ? task = 0;
);

// ---------------- layout ----------------
TBH = 26;
WX = 8; WY = TBH + 6;
WW = W - 16;
WH = max(90, floor(H * 0.36));
PY = WY + WH + 8;
padw = floor(WW / 16);
padh = 26;
PH = padh*4 + 6;
PRY = PY + PH + 8;

gfx_set(0.12,0.125,0.13,1);
gfx_rect(0,0,W,H);

// ---------------- toolbar ----------------
bx = 8;
btn(bx, 2, 74, 22, "CAPTURE", armed || capturing) ? (
  armed || capturing ? (
    capturing ? finish_capture() : armed = 0;
  ) : (
    armed = 1;
  );
);
bx += 80;
btn(bx, 2, 64, 22, "DETECT", task == 1) && capframes > 0 && task == 0 ? ( task = 1; det_new = 1; );
bx += 70;
btn(bx, 2, 70, 22, "CLASSIFY", task == 2) && nsl > 0 && task == 0 ? ( task = 2; cls_new = 1; );
bx += 76;
btn(bx, 2, 56, 22, "CLEAR", 0) ? ( nsl = 0; sel = -1; );
bx += 62;
btn(bx, 2, 78, 22, "MARKERS", 0) && gmem[0] == MAGIC ? import_markers();
bx += 84;

gfx_set(0.55,0.58,0.62,1);
gfx_x = bx + 6; gfx_y = 7;
capframes > 0 ? (
  sprintf(#info, "%d Hz  %.2fs  %d slices", cap_srate, capframes/max(cap_srate,1), nsl);
) : capturing ? (
  sprintf(#info, "recording... %.2fs", wr/srate);
) : armed ? (
  strcpy(#info, "armed - play the item or feed audio");
) : (
  strcpy(#info, "no audio - press CAPTURE, then play the item");
);
gfx_drawstr(#info);

midi_act ? (
  gfx_set(0.4,0.9,0.5,1);
  gfx_circle(W-14, 13, 5, 1);
  midi_act = 0;
);

// ---------------- waveform ----------------
gfx_set(0.16,0.165,0.175,1);
gfx_rect(WX, WY, WW, WH);

fr_show = capturing ? wr : capframes;
fr_show > 0 ? (
  wmid = WY + WH/2;
  // slice background tint for selected
  sel >= 0 && sel < nsl ? (
    x0 = WX + sl_start[sel]/fr_show * WW;
    x1 = WX + sl_end[sel]/fr_show * WW;
    gfx_set(0.25,0.30,0.38,0.45);
    gfx_rect(x0, WY, max(1, x1-x0), WH);
  );
  gfx_set(0.55,0.75,0.60,1);
  cx = 0;
  totbins = max(1, floor(fr_show/BINSZ));
  while (cx < WW) (
    b0 = floor(cx / WW * totbins);
    b1 = max(b0+1, floor((cx+1) / WW * totbins));
    pmn = 1; pmx = -1;
    bb = b0;
    while (bb < b1) (
      OVW[bb*2] < pmn ? pmn = OVW[bb*2];
      OVW[bb*2+1] > pmx ? pmx = OVW[bb*2+1];
      bb += 1;
    );
    pmx >= pmn ? (
      y0 = wmid - pmx * (WH/2 - 2);
      y1 = wmid - pmn * (WH/2 - 2);
      gfx_line(WX+cx, y0, WX+cx, max(y1, y0+1));
    );
    cx += 1;
  );
  // slice markers
  gsi = 0;
  while (gsi < nsl) (
    gmx = WX + sl_start[gsi]/fr_show * WW;
    classcol(sl_class[gsi]);
    gfx_line(gmx, WY, gmx, WY+WH);
    gfx_triangle(gmx, WY, gmx+7, WY, gmx, WY+9);
    gsi == sel ? (
      gfx_set(1,1,1,0.9);
      gfx_line(gmx+1, WY, gmx+1, WY+WH);
    );
    gfx_x = gmx+3; gfx_y = WY + WH - 14;
    gfx_set(0.7,0.72,0.75,1);
    sprintf(#sn, "%d", gsi+1);
    gfx_drawstr(#sn);
    gsi += 1;
  );
  // voice playheads
  gvi = 0;
  while (gvi < NVOICE) (
    gv = voices + gvi*VF;
    gv[fA] ? (
      php = sl_fx[gv[fS]] == 2 ? gv[fVT] : gv[fPOS];
      gpx = WX + php/fr_show * WW;
      gfx_set(1,1,1,0.35 + 0.5*gv[fENV]);
      gfx_line(gpx, WY, gpx, WY+WH);
    );
    gvi += 1;
  );
);

// waveform mouse interaction
m_inwave = mouse_x >= WX && mouse_x < WX+WW && mouse_y >= WY && mouse_y < WY+WH;
m_fr = (mouse_x - WX) / WW * max(fr_show,1);
m_inwave && lclick && fr_show > 0 && !capturing ? (
  // find nearest marker within 6 px
  hitm = -1; gsi = 0;
  while (gsi < nsl) (
    abs(WX + sl_start[gsi]/fr_show*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  (mouse_cap & 16) && hitm >= 0 ? (      // alt+click = delete
    del_slice(hitm);
  ) : dbl ? (
    add_slice(m_fr);
  ) : hitm >= 0 ? (
    drag_marker = hitm+1; sel = hitm;
  ) : (
    // select slice under cursor
    gsi = 0;
    while (gsi < nsl) (
      sl_start[gsi] <= m_fr ? sel = gsi;
      gsi += 1;
    );
  );
);
rclick && m_inwave && fr_show > 0 ? (
  hitm = -1; gsi = 0;
  while (gsi < nsl) (
    abs(WX + sl_start[gsi]/fr_show*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  hitm >= 0 ? del_slice(hitm);
);
drag_marker > 0 && (mouse_cap & 1) ? (
  di = drag_marker - 1;
  dlo = di > 0 ? sl_start[di-1] + 64 : 0;
  dhi = di < nsl-1 ? sl_start[di+1] - 64 : capframes - 64;
  sl_start[di] = max(dlo, min(dhi, floor(m_fr)));
  calc_ends();
);
drag_marker > 0 && !(mouse_cap & 1) ? drag_marker = 0;

// ---------------- pads ----------------
gpi = 0;
while (gpi < MAXSL) (
  prow = floor(gpi/16); pcol = gpi % 16;
  gpx = WX + pcol*padw; gpy = PY + prow*(padh+2);
  gpi < nsl ? (
    classcol(sl_class[gpi]);
    gpi == sel ? gfx_a = 1 : gfx_a = 0.55;
    gfx_rect(gpx, gpy, padw-2, padh);
    // per-pad playhead
    gvi = 0;
    while (gvi < NVOICE) (
      gv = voices + gvi*VF;
      gv[fA] && gv[fS] == gpi ? (
        php = sl_fx[gpi] == 2 ? gv[fVT] : gv[fPOS];
        prg = (php - sl_start[gpi]) / max(1, sl_end[gpi] - sl_start[gpi]);
        gfx_set(1,1,1,0.9);
        gfx_rect(gpx, gpy + padh - 3, max(1,(padw-2) * min(1,prg)), 3);
      );
      gvi += 1;
    );
    gfx_set(0.08,0.08,0.09,1);
    gfx_x = gpx+3; gfx_y = gpy+2;
    sprintf(#pn, "%d", gpi+1);
    gfx_drawstr(#pn);
    gfx_x = gpx+3; gfx_y = gpy+padh-14;
    sprintf(#pn, "%d", basenote+gpi);
    gfx_drawstr(#pn);
    // click = select + preview
    lclick && mouse_x >= gpx && mouse_x < gpx+padw-2 && mouse_y >= gpy && mouse_y < gpy+padh ? (
      sel = gpi;
      pv_req = gpi;
    );
  ) : (
    gfx_set(0.17,0.175,0.185,1);
    gfx_rect(gpx, gpy, padw-2, padh);
  );
  gpi += 1;
);

// ---------------- selected slice params ----------------
sel >= 0 && sel < nsl ? (
  fw = floor((WW - 10) / 6);
  fh = 30;
  fy = PRY;
  fx0 = WX;

  sprintf(#d, "%.1f st", sl_pitch[sel]);
  sl_pitch[sel] = ufield(1, fx0, fy, fw-4, fh, -24, 24, 0, 0, sl_pitch[sel], "PITCH", #d);
  sprintf(#d, "%.1f dB", sl_gain[sel]);
  sl_gain[sel] = ufield(2, fx0+fw, fy, fw-4, fh, -24, 12, 0, 0, sl_gain[sel], "GAIN", #d);
  sprintf(#d, "%d", floor(sl_pan[sel]*100+0.5));
  sl_pan[sel] = ufield(3, fx0+fw*2, fy, fw-4, fh, -1, 1, 0, 0, sl_pan[sel], "PAN", #d);
  fxname(sl_fx[sel], #d);
  sl_fx[sel] = ufield(4, fx0+fw*3, fy, fw-4, fh, 0, 7, 0, 1, sl_fx[sel], "FX", #d);
  sprintf(#d, "%d%%", floor(sl_amt[sel]*100+0.5));
  sl_amt[sel] = ufield(5, fx0+fw*4, fy, fw-4, fh, 0, 1, 0.5, 0, sl_amt[sel], "AMT", #d);
  sprintf(#d, "%d%%", floor(sl_p2[sel]*100+0.5));
  sl_p2[sel] = ufield(6, fx0+fw*5, fy, fw-4, fh, 0, 1, 0.5, 0, sl_p2[sel], "P2", #d);

  fy += fh + 4;
  classname(sl_class[sel], #d);
  sl_class[sel] = ufield(7, fx0, fy, fw-4, fh, 0, 5, 0, 1, sl_class[sel], "CLASS", #d);
  sprintf(#d, "%d", sl_choke[sel]);
  sl_choke[sel] = floor(ufield(8, fx0+fw, fy, fw-4, fh, 0, 4, 0, 1, sl_choke[sel], "CHOKE", #d)+0.5);
  moutname(sl_mout[sel], #d);
  sl_mout[sel] = ufield(9, fx0+fw*2, fy, fw-4, fh, 0, 2, 0, 1, sl_mout[sel], "MIDI OUT", #d);
  sprintf(#d, "%d", floor(sl_mnum[sel]+0.5));
  sl_mnum[sel] = floor(ufield(10, fx0+fw*3, fy, fw-4, fh, 0, 127, 36, 0, sl_mnum[sel], "NUM", #d)+0.5);
  sprintf(#d, "%d", floor(sl_mchan[sel]+0.5)+1);
  sl_mchan[sel] = floor(ufield(11, fx0+fw*4, fy, fw-4, fh, 0, 15, 0, 0, sl_mchan[sel], "CHAN", #d)+0.5);
  sprintf(#d, "%d", floor(sl_mbus[sel]+0.5)+1);
  sl_mbus[sel] = floor(ufield(12, fx0+fw*5, fy, fw-4, fh, 0, 15, 0, 0, sl_mbus[sel], "BUS", #d)+0.5);
) : (
  gfx_set(0.4,0.42,0.45,1);
  gfx_x = WX; gfx_y = PRY + 8;
  gfx_drawstr("no slice selected - capture audio, then DETECT or double-click the waveform");
);

// ---------------- footer: global playback fields ----------------
fy2 = PRY + 30*2 + 12;
fy2 + 30 < H ? (
  fw2 = floor((WW - 10) / 6);
  strcpy(#d, monomode ? "MONO" : "POLY");
  monomode = ufield(20, WX, fy2, fw2-4, 26, 0, 1, 0, 1, monomode, "VOICES", #d);
  strcpy(#d, legato ? "ON" : "OFF");
  legato = ufield(21, WX+fw2, fy2, fw2-4, 26, 0, 1, 0, 1, legato, "LEGATO", #d);
  sprintf(#d, "%d ms", floor(glide_ms+0.5));
  glide_ms = ufield(22, WX+fw2*2, fy2, fw2-4, 26, 0, 500, 0, 0, glide_ms, "GLIDE", #d);
  strcpy(#d, interp < 0.5 ? "NONE" : interp < 1.5 ? "LIN" : "HERM");
  interp = ufield(23, WX+fw2*3, fy2, fw2-4, 26, 0, 2, 2, 1, interp, "INTERP", #d);
  strcpy(#d, gatemode ? "GATE" : "1-SHOT");
  gatemode = ufield(24, WX+fw2*4, fy2, fw2-4, 26, 0, 1, 0, 1, gatemode, "TRIG", #d);
  sprintf(#d, "%d", floor(basenote+0.5));
  basenote = floor(ufield(25, WX+fw2*5, fy2, fw2-4, 26, 0, 96, 36, 0, basenote, "BASE NOTE", #d)+0.5);
);

gfx_set(0.38,0.40,0.43,1);
gfx_x = WX; gfx_y = H - 15;
gfx_drawstr("wave: click=select  dblclick=add  drag=move  alt/right-click=del  |  pads: click=preview  |  markers: run jf_slixer_push_markers.lua");

task ? (
  gfx_set(0.9,0.8,0.3,1);
  gfx_x = W - 90; gfx_y = H - 15;
  gfx_drawstr(task == 1 ? "detecting..." : task == 2 ? "classifying..." : "rebuilding...");
);

last_cap = mouse_cap;
