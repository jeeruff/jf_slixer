desc:jf_slixer - dual-deck transient slicer / pad sampler
//tags: sampler slicer drums
//author: jeeruff

options:maxmem=33554432
options:gmem=jf_slixer

slider1:sens=0.50<0.05,1,0.01>Transient sensitivity
slider2:basenote_a=36<0,127,1>Deck A base note
slider3:monomode=0<0,1,1{Poly,Mono}>Voice mode
slider4:legato=0<0,1,1{Off,On}>Legato
slider5:glide_ms=0<0,500,1>Glide (ms)
slider6:interp=2<0,2,1{None,Linear,Hermite}>Interpolation
slider7:gatemode=0<0,1,1{One-shot,Gate}>Trigger mode
slider8:mgain_db=0<-24,12,0.1>Master gain (dB)
slider9:caplen=8<1,120,1>Max capture (s)
slider10:saveaudio=1<0,1,1{No,Yes}>Save audio in project
slider11:thru=1<0,1,1{Off,On}>Input passthrough
slider12:xfade=0.5<0,1,0.001>Crossfade A-B
slider13:outmode=0<0,1,1{Mix on 1/2,Split A:1/2 B:3/4}>Output routing
slider14:basenote_b=84<0,127,1>Deck B base note
slider15:mcha=0<0,16,1>Deck A MIDI channel (0=omni)
slider16:mchb=0<0,16,1>Deck B MIDI channel (0=omni)
slider17:preroll_ms=5<0,100,1>Slice pre-roll (ms)
slider20:/jf_slixer:none:Deck A sample file
slider21:/jf_slixer:none:Deck B sample file

in_pin:left
in_pin:right
out_pin:out 1 (A / mix L)
out_pin:out 2 (A / mix R)
out_pin:out 3 (B L)
out_pin:out 4 (B R)

@init
ext_noinit = 1;
ext_midi_bus = 1;

MAXSL   = 64;
NVOICE  = 16;
VF      = 32;
MAGIC   = 8888123;
BINSZ   = 256;

// memory map
qoff    = 3000;               // pending note-off queue, 32*3
dk_frames = 3200;             // per-deck scalars, index by deck 0/1
dk_srate  = 3204;
dk_nsl    = 3208;
dk_sel    = 3212;
dk_sync   = 3216;             // 0=off 1=repitch 2=stretch
SL0     = 4096;               // slice tables: deck stride 1024, field stride 64
V0      = 8192;               // voices: deck stride 1024 (16 * 32)
PRE     = 16384;              // presets: 16 slots (2 decks * 8) * 1024
SCR     = 32768;              // file-load scratch (32768 words, up to OVW0)
OVW0    = 65536;              // overview bins: 5 words/bin (min,max,elo,emid,ehi)
OVWST   = 172032;             // per-deck overview stride
BUF0    = 409600;             // audio: stereo interleaved, deck stride below
DECKW   = (33554432 - BUF0) / 2;
DECKFR  = DECKW / 2;

// slice field offsets within deck slice base (15 fields, stride 64)
OF_START=0; OF_END=64; OF_PITCH=128; OF_GAIN=192; OF_PAN=256; OF_FX=320;
OF_AMT=384; OF_P2=448; OF_CHOKE=512; OF_CLASS=576; OF_MOUT=640; OF_MNUM=704;
OF_MCHAN=768; OF_MBUS=832; OF_MODE=896;
NSLF = 15;

// voice fields
fA=0; fS=1; fPOS=2; fRATE=3; fTR=4; fENV=5; fST=6; fGL=7; fGR=8; fNOTE=9;
fVT=10; fPA=11; fPB=12; fPHA=13; fPHB=14; fBCC=15; fBHL=16; fBHR=17;
fPH1=18; fCEN=19; fEND=20; fVEL=21; fONOTE=22; fOCH=23; fOBUS=24;
fDIR=25; fSTART=26;

!initdone ? (
  initdone = 1;
  cur = 0;
  dk_sel[0] = -1; dk_sel[1] = -1;
  dk_srate[0] = srate; dk_srate[1] = srate;
  pv_req = -1; pv_deck = 0;
  fld_active = -1;
  task = 0;
  auto_det = 1;
  gfa_req = -1; gfb_req = -1;
);

function slb(d) ( SL0 + d*1024 );
function dbuf(d) ( BUF0 + d*DECKW );

function slice_defaults(d i) local(sb) (
  sb = slb(d);
  sb[OF_PITCH+i]=0; sb[OF_GAIN+i]=0; sb[OF_PAN+i]=0;
  sb[OF_FX+i]=0; sb[OF_AMT+i]=0.5; sb[OF_P2+i]=0.5;
  sb[OF_CHOKE+i]=0; sb[OF_CLASS+i]=0;
  sb[OF_MOUT+i]=0; sb[OF_MNUM+i]=36+i; sb[OF_MCHAN+i]=0; sb[OF_MBUS+i]=0;
  sb[OF_MODE+i]=0;
);

function sort_slices(d) local(sb i j k p t) (
  sb = slb(d);
  i = 1;
  while (i < dk_nsl[d]) (
    j = i;
    while (j > 0 && sb[OF_START+j-1] > sb[OF_START+j]) (
      k = 0;
      while (k < NSLF) (
        p = sb + k*64 + j;
        t = p[-1]; p[-1] = p[0]; p[0] = t;
        k += 1;
      );
      j -= 1;
    );
    i += 1;
  );
);

function calc_ends(d) local(sb i) (
  sort_slices(d);
  sb = slb(d);
  i = 0;
  while (i < dk_nsl[d]) (
    sb[OF_END+i] = i < dk_nsl[d]-1 ? sb[OF_START+i+1] : dk_frames[d];
    i += 1;
  );
);

function del_slice(d idx) local(sb j k p) (
  sb = slb(d);
  j = idx;
  while (j < dk_nsl[d]-1) (
    k = 0;
    while (k < NSLF) (
      p = sb + k*64 + j;
      p[0] = p[1];
      k += 1;
    );
    j += 1;
  );
  dk_nsl[d] -= 1;
  dk_sel[d] >= dk_nsl[d] ? dk_sel[d] = dk_nsl[d]-1;
  calc_ends(d);
);

function add_slice(d fr) local(sb i) (
  sb = slb(d);
  dk_nsl[d] < MAXSL && dk_frames[d] > 0 ? (
    fr = max(0, min(dk_frames[d]-64, floor(fr)));
    sb[OF_START+dk_nsl[d]] = fr;
    slice_defaults(d, dk_nsl[d]);
    dk_nsl[d] += 1;
    calc_ends(d);
    i = 0; dk_sel[d] = 0;
    while (i < dk_nsl[d]) ( sb[OF_START+i] == fr ? dk_sel[d] = i; i += 1; );
  );
);

function import_markers(d) local(sb n i p) (
  sb = slb(d);
  n = min(gmem[2], MAXSL);
  dk_frames[d] > 0 && n > 0 ? (
    dk_nsl[d] = 0;
    i = 0;
    while (i < n) (
      p = floor(gmem[8+i] * dk_srate[d]);
      p >= 0 && p < dk_frames[d] ? (
        sb[OF_START+dk_nsl[d]] = p;
        slice_defaults(d, dk_nsl[d]);
        dk_nsl[d] += 1;
      );
      i += 1;
    );
    calc_ends(d);
    dk_sel[d] = dk_nsl[d] > 0 ? 0 : -1;
  );
);

function preset_save(d slot) local(p) (
  p = PRE + (d*8+slot)*1024;
  p[0] = 1;
  p[1] = dk_nsl[d];
  memcpy(p+16, slb(d), NSLF*64);
);

function preset_load(d slot) local(p i sb) (
  p = PRE + (d*8+slot)*1024;
  sb = slb(d);
  p[0] ? (
    memcpy(sb, p+16, NSLF*64);
    dk_nsl[d] = p[1];
    i = dk_nsl[d]-1;
    while (i >= 0) (
      sb[OF_START+i] >= max(dk_frames[d],64) ? del_slice(d, i);
      i -= 1;
    );
    calc_ends(d);
    dk_sel[d] = dk_nsl[d] > 0 ? min(max(dk_sel[d],0), dk_nsl[d]-1) : -1;
  );
);

function preset_clear(d slot) local(p) (
  p = PRE + (d*8+slot)*1024;
  p[0] = 0;
);

function qpush(v) (
  qn < 32 ? (
    q = qoff + qn*3;
    q[0] = v[fOBUS]; q[1] = v[fOCH]; q[2] = v[fONOTE]-1;
    qn += 1;
  );
  v[fONOTE] = 0;
);

// advance boundary handling: fidx = fPOS or fVT; mode 0=fwd 1=rev 2=loop 3=pingpong
function wrap_pos(v fidx mode) local(p st en) (
  p = v[fidx]; st = v[fSTART]; en = v[fEND];
  mode == 2 ? (
    p >= en ? p = st + (en - st > 1 ? p - en : 0);
  ) : mode == 3 ? (
    p >= en ? ( v[fDIR] = -1; p = max(st, 2*en - p - 1); );
    p <= st ? ( v[fDIR] = 1; p = min(en, 2*st - p); );
  ) : mode == 1 ? (
    p <= st ? v[fST] = 3;
  ) : (
    p >= en ? v[fST] = 3;
  );
  v[fidx] = p;
);

// audio-thread read; cd_buf / cd_frames must be set for the deck first
function readsmp(pos ch) local(i f a b c d c1 c2 c3) (
  pos < 1 ? pos = 1;
  pos > cd_frames-3 ? pos = cd_frames-3;
  interp < 0.5 ? (
    cd_buf[floor(pos+0.5)*2+ch];
  ) : interp < 1.5 ? (
    i = floor(pos); f = pos - i;
    a = cd_buf[i*2+ch];
    a + (cd_buf[i*2+2+ch] - a) * f;
  ) : (
    i = floor(pos); f = pos - i;
    a = cd_buf[(i-1)*2+ch]; b = cd_buf[i*2+ch];
    c = cd_buf[(i+1)*2+ch]; d = cd_buf[(i+2)*2+ch];
    c1 = 0.5*(c-a);
    c2 = a - 2.5*b + 2*c - 0.5*d;
    c3 = 0.5*(d-a) + 1.5*(b-c);
    ((c3*f + c2)*f + c1)*f + b;
  );
);

function trigger_slice(d s vel note ofs) local(sb vb vi v cg tr vol pl pr leg was best bi stp) (
  sb = slb(d); vb = V0 + d*1024;
  s >= 0 && s < dk_nsl[d] && dk_frames[d] > 0 && sb[OF_START+s] < sb[OF_END+s] ? (
    cg = sb[OF_CHOKE+s];
    cg ? (
      vi = 0;
      while (vi < NVOICE) (
        v = vb + vi*VF;
        v[fA] && sb[OF_CHOKE+v[fS]] == cg ? v[fST] = 3;
        vi += 1;
      );
    );
    monomode ? (
      vi = 0;
    ) : (
      bi = -1; best = 2; vi = 0;
      while (vi < NVOICE) (
        v = vb + vi*VF;
        v[fA] == 0 ? ( bi = vi; vi = NVOICE; )
        : ( v[fENV] <= best ? ( best = v[fENV]; bi = vi; ); vi += 1; );
      );
      vi = bi;
    );
    v = vb + vi*VF;
    v[fA] && v[fONOTE] ? qpush(v);
    was = v[fA] && v[fST] != 3;
    leg = monomode && legato && was;
    tr = pow(2, sb[OF_PITCH+s]/12) * (dk_srate[d] > 0 ? dk_srate[d]/srate : 1);
    v[fTR] = tr;
    v[fRATE] = (monomode && glide_ms > 0 && was) ? v[fRATE] : tr;
    v[fS] = s; v[fEND] = sb[OF_END+s]; v[fSTART] = sb[OF_START+s];
    v[fDIR] = sb[OF_MODE+s] == 1 ? -1 : 1;
    stp = sb[OF_MODE+s] == 1 ? sb[OF_END+s] - 2 : sb[OF_START+s];
    v[fPOS] = stp; v[fVT] = stp;
    v[fPA] = stp; v[fPB] = stp;
    v[fPHA] = 0; v[fPHB] = 0.5;
    leg ? 0 : (
      v[fENV] = v[fA] ? v[fENV] : 0;
      v[fST] = 1;
    );
    vol = pow(10, sb[OF_GAIN+s]/20) * (vel/127);
    pl = min(1, 1 - sb[OF_PAN+s]); pr = min(1, 1 + sb[OF_PAN+s]);
    v[fGL] = vol*pl; v[fGR] = vol*pr;
    v[fBCC] = 0; v[fBHL] = 0; v[fBHR] = 0; v[fPH1] = 0; v[fCEN] = 0;
    v[fNOTE] = note; v[fVEL] = vel;
    v[fA] = 1;
    sb[OF_MOUT+s] == 1 ? (
      midi_bus = sb[OF_MBUS+s];
      midisend(ofs, $x90 | sb[OF_MCHAN+s], sb[OF_MNUM+s], vel);
      v[fONOTE] = sb[OF_MNUM+s]+1; v[fOCH] = sb[OF_MCHAN+s]; v[fOBUS] = sb[OF_MBUS+s];
    ) : sb[OF_MOUT+s] == 2 ? (
      midi_bus = sb[OF_MBUS+s];
      midisend(ofs, $xB0 | sb[OF_MCHAN+s], sb[OF_MNUM+s], vel);
      v[fONOTE] = 0;
    ) : v[fONOTE] = 0;
  );
);

function release_note(note) local(d vi v vb sbd md) (
  d = 0;
  while (d < 2) (
    vb = V0 + d*1024; sbd = slb(d);
    vi = 0;
    while (vi < NVOICE) (
      v = vb + vi*VF;
      v[fA] && v[fNOTE] == note ? (
        md = sbd[OF_MODE + v[fS]];
        // loop/pingpong always gate on note-off; others follow global TRIG
        (gatemode || md == 2 || md == 3) ? v[fST] = 3;
      );
      vi += 1;
    );
    d += 1;
  );
);

function kill_all() local(d vi v) (
  d = 0;
  while (d < 2) (
    vi = 0;
    while (vi < NVOICE) (
      v = V0 + d*1024 + vi*VF;
      v[fA] ? v[fST] = 3;
      vi += 1;
    );
    d += 1;
  );
);

function finish_capture() local(b ob) (
  capturing = 0; armed = 0;
  dk_frames[rec_d] = wr;
  dk_srate[rec_d] = srate;
  wr > 0 && (wr & (BINSZ-1)) ? (
    b = floor(wr/BINSZ);
    ob = OVW0 + rec_d*OVWST + b*5;
    ob[0] = binmin; ob[1] = binmax;
    ob[2] = belo; ob[3] = bemid; ob[4] = behi;
  );
  dk_nsl[rec_d] > 0 ? calc_ends(rec_d);
  wr > 0 && auto_det ? ( auto_det_req = 1; auto_det_d = rec_d; );
);

function load_sample(d fs)
local(h nch fsr frames base chunkfr wrp n i scr l_ r_ cm_ ovp bmn bmx el em eh lp lp2 klo khi bi)
(
  h = file_open(fs);
  h > 0 ? (
    nch = 0; fsr = 0;
    file_riff(h, nch, fsr);
    nch > 0 && fsr > 0 ? (
      frames = min(floor(file_avail(h)/nch), DECKFR);
      frames > 0 ? (
        base = dbuf(d);
        ovp = OVW0 + d*OVWST;
        scr = SCR;
        chunkfr = max(1, floor(28672/nch));
        klo = 1 - exp(-2*$pi*200/fsr);
        khi = 1 - exp(-2*$pi*4000/fsr);
        bmn = 1; bmx = -1; el = 0; em = 0; eh = 0; lp = 0; lp2 = 0;
        wrp = 0;
        while (wrp < frames) (
          n = min(chunkfr, frames - wrp);
          file_mem(h, scr, n*nch);
          i = 0;
          while (i < n) (
            l_ = scr[i*nch];
            r_ = nch > 1 ? scr[i*nch+1] : l_;
            base[(wrp+i)*2] = l_;
            base[(wrp+i)*2+1] = r_;
            cm_ = (l_ + r_)*0.5;
            cm_ > bmx ? bmx = cm_;
            cm_ < bmn ? bmn = cm_;
            lp += (cm_ - lp)*klo;
            lp2 += (cm_ - lp2)*khi;
            el += lp*lp;
            em += (lp2 - lp)*(lp2 - lp);
            eh += (cm_ - lp2)*(cm_ - lp2);
            ( ((wrp+i) & (BINSZ-1)) == (BINSZ-1) || wrp+i == frames-1 ) ? (
              bi = ovp + floor((wrp+i)/BINSZ)*5;
              bi[0]=bmn; bi[1]=bmx; bi[2]=el; bi[3]=em; bi[4]=eh;
              bmn = 1; bmx = -1; el = 0; em = 0; eh = 0;
            );
            i += 1;
          );
          wrp += n;
        );
        dk_frames[d] = frames;
        dk_srate[d] = fsr;
        dk_nsl[d] = 0; dk_sel[d] = -1;
        auto_det ? ( auto_det_req = 1; auto_det_d = d; );
      );
    );
    file_close(h);
  );
);

@slider
!slider_seen ? (
  // first run after init: don't clobber project-restored audio
  slider_seen = 1;
  lastfile_a = slider20; lastfile_b = slider21;
  dk_frames[0] <= 0 && slider20 > 0 ? load_sample(0, slider20);
  dk_frames[1] <= 0 && slider21 > 0 ? load_sample(1, slider21);
) : (
  slider20 != lastfile_a ? ( lastfile_a = slider20; load_sample(0, slider20); );
  slider21 != lastfile_b ? ( lastfile_b = slider21; load_sample(1, slider21); );
);

@block
gmem[6] = cur;  // publish active deck for companion scripts

// dropped file from @gfx
drop_req ? (
  drop_req = 0;
  load_sample(cur, #droppath);
);

// ---- audio stream from jf_slixer_load_sample.lua (any file, any folder) ----
gmem[100] == 1 ? (  // header
  xh_d = gmem[101] > 0.5 ? 1 : 0;
  xh_sr = gmem[102];
  xh_total = min(gmem[103], DECKFR);
  xh_wr = 0;
  xh_sr > 0 && xh_total > 0 ? (
    xh_active = 1;
    xh_bmn = 1; xh_bmx = -1;
    xh_el = 0; xh_em = 0; xh_eh = 0;
    xh_lp = 0; xh_lp2 = 0;
    xh_klo = 1 - exp(-2*$pi*200/xh_sr);
    xh_khi = 1 - exp(-2*$pi*4000/xh_sr);
  ) : xh_active = 0;
  gmem[100] = 0;
) : gmem[100] == 2 && xh_active ? (  // chunk of interleaved stereo at gmem[16384]
  xn = gmem[104];
  xbase = dbuf(xh_d);
  xovp = OVW0 + xh_d*OVWST;
  xi = 0;
  while (xi < xn && xh_wr < xh_total) (
    xl = gmem[16384 + xi*2];
    xr = gmem[16384 + xi*2 + 1];
    xbase[xh_wr*2] = xl; xbase[xh_wr*2+1] = xr;
    xcm = (xl + xr)*0.5;
    xcm > xh_bmx ? xh_bmx = xcm;
    xcm < xh_bmn ? xh_bmn = xcm;
    xh_lp += (xcm - xh_lp)*xh_klo;
    xh_lp2 += (xcm - xh_lp2)*xh_khi;
    xh_el += xh_lp*xh_lp;
    xh_em += (xh_lp2 - xh_lp)*(xh_lp2 - xh_lp);
    xh_eh += (xcm - xh_lp2)*(xcm - xh_lp2);
    (xh_wr & (BINSZ-1)) == (BINSZ-1) ? (
      xp = xovp + floor(xh_wr/BINSZ)*5;
      xp[0]=xh_bmn; xp[1]=xh_bmx; xp[2]=xh_el; xp[3]=xh_em; xp[4]=xh_eh;
      xh_bmn = 1; xh_bmx = -1;
      xh_el = 0; xh_em = 0; xh_eh = 0;
    );
    xh_wr += 1; xi += 1;
  );
  gmem[100] = 0;
) : gmem[100] == 3 && xh_active ? (  // done
  xh_active = 0;
  xh_wr > 0 ? (
    (xh_wr & (BINSZ-1)) ? (
      xp = OVW0 + xh_d*OVWST + floor(xh_wr/BINSZ)*5;
      xp[0]=xh_bmn; xp[1]=xh_bmx; xp[2]=xh_el; xp[3]=xh_em; xp[4]=xh_eh;
    );
    dk_frames[xh_d] = xh_wr;
    dk_srate[xh_d] = xh_sr;
    dk_nsl[xh_d] = 0; dk_sel[xh_d] = -1;
    auto_det ? ( auto_det_req = 1; auto_det_d = xh_d; );
  );
  gmem[100] = 0;
);

// file prev/next requests from the UI
gfa_req >= 0 ? (
  slider20 = gfa_req; gfa_req = -1;
  lastfile_a = slider20;
  load_sample(0, slider20);
  sliderchange(slider20);
);
gfb_req >= 0 ? (
  slider21 = gfb_req; gfb_req = -1;
  lastfile_b = slider21;
  load_sample(1, slider21);
  sliderchange(slider21);
);
mvol = pow(10, mgain_db/20);
gcoef = glide_ms <= 0 ? 1 : 1 - exp(-1/(glide_ms * 0.001 * srate));
atk_inc = 1 / max(1, 0.0015*srate);
rel_c = exp(-1/(0.004*srate));
klo_rec = 1 - exp(-2*$pi*200/srate);
khi_rec = 1 - exp(-2*$pi*4000/srate);
xga = cos(xfade * $pi * 0.5);
xgb = sin(xfade * $pi * 0.5);

// tempo-sync multipliers: fit deck length to nearest whole beats at project tempo
sm0 = 1; sm1 = 1;
smd = 0;
while (smd < 2) (
  dk_sync[smd] && dk_frames[smd] > 0 && dk_srate[smd] > 0 && tempo > 0 ? (
    smb = dk_frames[smd]/dk_srate[smd] * tempo / 60;
    smbi = max(1, floor(smb + 0.5));
    smd ? sm1 = smb/smbi : sm0 = smb/smbi;
  );
  smd += 1;
);

qi = 0;
while (qi < qn) (
  q = qoff + qi*3;
  midi_bus = q[0];
  midisend(0, $x80 | q[1], q[2], 0);
  qi += 1;
);
qn = 0;

gmem[0] == MAGIC && gmem[1] != g_serial ? (
  g_serial = gmem[1];
  !capturing ? import_markers(cur);
);

pv_req >= 0 ? (
  trigger_slice(pv_deck, pv_req, 100, -1, 0);
  pv_req = -1;
);

while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & $xF0;
  mch = m1 & $x0F;
  st == $x90 && m3 > 0 ? (
    (mcha == 0 || mch == mcha-1) ? trigger_slice(0, m2 - basenote_a, m3, m2, ofs);
    (mchb == 0 || mch == mchb-1) ? trigger_slice(1, m2 - basenote_b, m3, m2, ofs);
    midi_act = 1;
  ) : (st == $x80 || (st == $x90 && m3 == 0)) ? (
    release_note(m2);
  ) : st == $xB0 && (m2 == 123 || m2 == 120) ? (
    kill_all();
  );
  midisend(ofs, m1, m2, m3);
);

@sample
// capture into rec_d
armed ? (
  !capturing ? (
    (play_state & 1) || (abs(spl0) + abs(spl1) > 0.001) ? (
      capturing = 1; wr = 0;
      binmin = 1; binmax = -1;
      belo = 0; bemid = 0; behi = 0;
      rec_lp = 0; rec_lp2 = 0;
    );
  );
  capturing ? (
    maxfr = min(DECKFR, caplen * srate);
    wr < maxfr ? (
      rb = dbuf(rec_d);
      rb[wr*2] = spl0; rb[wr*2+1] = spl1;
      cm = (spl0 + spl1) * 0.5;
      cm > binmax ? binmax = cm;
      cm < binmin ? binmin = cm;
      rec_lp += (cm - rec_lp) * klo_rec;
      rec_lp2 += (cm - rec_lp2) * khi_rec;
      belo += rec_lp*rec_lp;
      bemid += (rec_lp2 - rec_lp)*(rec_lp2 - rec_lp);
      behi += (cm - rec_lp2)*(cm - rec_lp2);
      (wr & (BINSZ-1)) == (BINSZ-1) ? (
        rob = OVW0 + rec_d*OVWST + floor(wr/BINSZ)*5;
        rob[0] = binmin; rob[1] = binmax;
        rob[2] = belo; rob[3] = bemid; rob[4] = behi;
        binmin = 1; binmax = -1;
        belo = 0; bemid = 0; behi = 0;
      );
      wr += 1;
    ) : (
      finish_capture();
    );
  );
);

d_l0 = 0; d_r0 = 0; d_l1 = 0; d_r1 = 0;
dd = 0;
while (dd < 2) (
  cd_buf = dbuf(dd);
  cd_frames = dk_frames[dd];
  cd_sb = slb(dd);
  cd_vb = V0 + dd*1024;
  cd_sm = dd ? sm1 : sm0;
  cd_syncmode = dk_sync[dd];
  aol = 0; aor = 0;
  vi = 0;
  while (vi < NVOICE) (
    v = cd_vb + vi*VF;
    v[fA] ? (
      s = v[fS];
      fx = cd_sb[OF_FX+s];
      amt = cd_sb[OF_AMT+s]; p2 = cd_sb[OF_P2+s];
      smode = cd_sb[OF_MODE+s];
      v[fRATE] += (v[fTR] - v[fRATE]) * gcoef;
      rt = v[fRATE] * (cd_syncmode == 1 ? cd_sm : 1);

      (fx == 2 || (cd_syncmode == 2 && fx != 4)) ? (
        // granular: 2 hann-windowed heads, timeline independent of pitch;
        // also forced for all voices when deck sync mode is STRETCH
        spd = (fx == 2 ? pow(4, 1 - 2*amt) : 1)
              * (dk_srate[dd] > 0 ? dk_srate[dd]/srate : 1)
              * (cd_syncmode ? cd_sm : 1);
        glen = (fx == 2 ? 0.02 + p2*0.1 : 0.06) * srate;
        v[fVT] += spd * v[fDIR];
        wrap_pos(v, fVT, smode);
        v[fPA] += rt; v[fPB] += rt;
        v[fPHA] += 1/glen; v[fPHB] += 1/glen;
        v[fPHA] >= 1 ? ( v[fPHA] -= 1; v[fPA] = v[fVT]; );
        v[fPHB] >= 1 ? ( v[fPHB] -= 1; v[fPB] = v[fVT]; );
        wa = 0.5 - 0.5*cos(2*$pi*v[fPHA]);
        wb = 0.5 - 0.5*cos(2*$pi*v[fPHB]);
        l = readsmp(v[fPA],0)*wa + readsmp(v[fPB],0)*wb;
        r = readsmp(v[fPA],1)*wa + readsmp(v[fPB],1)*wb;
      ) : fx == 4 ? (
        // FM of playback position
        frq = 30 * pow(2, p2*7);
        v[fPH1] += frq/srate * 2*$pi;
        mp = v[fPOS] + sin(v[fPH1]) * amt*amt*400;
        l = readsmp(mp,0); r = readsmp(mp,1);
        v[fPOS] += rt * v[fDIR];
        wrap_pos(v, fPOS, smode);
      ) : (
        l = readsmp(v[fPOS],0); r = readsmp(v[fPOS],1);
        v[fPOS] += rt * v[fDIR];
        wrap_pos(v, fPOS, smode);
      );

      fx == 1 ? (
        // bitcrush: amt=depth, p2=rate divide
        v[fBCC] -= 1;
        v[fBCC] <= 0 ? (
          v[fBCC] = 1 + floor(p2*31);
          qz = pow(2, 15 - amt*14);
          v[fBHL] = floor(l*qz + 0.5)/qz;
          v[fBHR] = floor(r*qz + 0.5)/qz;
        );
        l = v[fBHL]; r = v[fBHR];
      ) : fx == 3 ? (
        // compressor: amt=amount, p2=release
        ain = max(abs(l), abs(r));
        ain > v[fCEN] ? v[fCEN] += (ain - v[fCEN])*0.15
                      : v[fCEN] *= exp(-1/((0.03 + p2*0.5)*srate));
        cg = v[fCEN] > 0.1 ? pow(v[fCEN]/0.1, -0.8*amt) : 1;
        cg *= 1 + amt*2.5;
        l *= cg; r *= cg;
      ) : fx == 5 ? (
        // AM/tremolo: amt=depth, p2=rate
        frq = 0.5 * pow(2, p2*11);
        v[fPH1] += frq/srate * 2*$pi;
        cg = 1 - amt*(0.5 + 0.5*sin(v[fPH1]));
        l *= cg; r *= cg;
      ) : fx == 6 ? (
        // ringmod: amt=mix, p2=freq
        frq = 30 * pow(2, p2*7);
        v[fPH1] += frq/srate * 2*$pi;
        rm = sin(v[fPH1]);
        l = l*(1-amt) + l*rm*amt;
        r = r*(1-amt) + r*rm*amt;
      ) : fx == 7 ? (
        // saturator: amt=drive, p2=tone
        dv = 1 + amt*24;
        l = l*dv/(1 + abs(l*dv));
        r = r*dv/(1 + abs(r*dv));
        tc = 1 - exp(-2*$pi*(200 + p2*p2*18000)/srate);
        v[fBHL] += (l - v[fBHL])*tc;
        v[fBHR] += (r - v[fBHR])*tc;
        l = v[fBHL]; r = v[fBHR];
      ) : fx == 8 ? (
        // samplerate reduction: amt=depth (down to ~srate/128), p2=jitter grit
        v[fBCC] -= 1;
        v[fBCC] <= 0 ? (
          srstep = 1 + amt*amt*127;
          p2 > 0 ? srstep *= 1 + (rand(2)-1)*p2*0.9;
          v[fBCC] += max(1, srstep);
          v[fBHL] = l; v[fBHR] = r;
        );
        l = v[fBHL]; r = v[fBHR];
      );

      v[fST] == 1 ? (
        v[fENV] += atk_inc;
        v[fENV] >= 1 ? ( v[fENV] = 1; v[fST] = 2; );
      ) : v[fST] == 3 ? (
        v[fENV] *= rel_c;
        v[fENV] < 0.001 ? (
          v[fA] = 0;
          v[fONOTE] ? qpush(v);
        );
      );
      aol += l * v[fENV] * v[fGL];
      aor += r * v[fENV] * v[fGR];
    );
    vi += 1;
  );
  dd == 0 ? ( d_l0 = aol; d_r0 = aor; ) : ( d_l1 = aol; d_r1 = aor; );
  dd += 1;
);

outmode < 0.5 ? (
  spl0 = spl0*thru + (d_l0*xga + d_l1*xgb)*mvol;
  spl1 = spl1*thru + (d_r0*xga + d_r1*xgb)*mvol;
  spl2 = d_l1*xgb*mvol;
  spl3 = d_r1*xgb*mvol;
) : (
  spl0 = spl0*thru + d_l0*xga*mvol;
  spl1 = spl1*thru + d_r0*xga*mvol;
  spl2 = d_l1*xgb*mvol;
  spl3 = d_r1*xgb*mvol;
);

@serialize
srz_ver = 4;
file_var(0, srz_ver);
srz_wr = file_avail(0) < 0;
file_var(0, cur);
(srz_ver >= 3 || srz_wr) ? file_var(0, auto_det);
// per-deck scalars: frames, srate, nsl, sel (+sync from v4)
file_mem(0, 3200, (srz_ver >= 4 || srz_wr) ? 24 : 16);
srz_d = 0;
while (srz_d < 2) (
  srz_sb = slb(srz_d);
  file_mem(0, srz_sb, (srz_ver >= 4 || srz_wr) ? NSLF*64 : 14*64);
  file_avail(0) < 0 ? ( srz_aud = saveaudio && dk_frames[srz_d] > 0 ? 1 : 0; );
  file_var(0, srz_aud);
  srz_b = dbuf(srz_d);
  srz_aud ? file_mem(0, srz_b, dk_frames[srz_d]*2);
  srz_d += 1;
);
file_mem(0, PRE, 16*1024);
file_avail(0) >= 0 ? (
  dk_srate[0] <= 0 ? dk_srate[0] = srate;
  dk_srate[1] <= 0 ? dk_srate[1] = srate;
  (dk_frames[0] > 0 || dk_frames[1] > 0) ? ( task = 3; ov_d = 0; ov_i = 0; );
);

@gfx 760 560

function fxname(i dst) (
  i==0 ? strcpy(dst,"OFF") : i==1 ? strcpy(dst,"CRUSH") : i==2 ? strcpy(dst,"STRETCH") :
  i==3 ? strcpy(dst,"COMP") : i==4 ? strcpy(dst,"FM") : i==5 ? strcpy(dst,"AM") :
  i==6 ? strcpy(dst,"RING") : i==7 ? strcpy(dst,"SAT") : strcpy(dst,"DOWN");
);
function classname(i dst) (
  i==0 ? strcpy(dst,"-") : i==1 ? strcpy(dst,"KICK") : i==2 ? strcpy(dst,"SNARE") :
  i==3 ? strcpy(dst,"HAT") : i==4 ? strcpy(dst,"PERC") : strcpy(dst,"CRASH");
);
function classcol(i) (
  i==1 ? gfx_set(0.95,0.45,0.30,1) :
  i==2 ? gfx_set(0.95,0.85,0.35,1) :
  i==3 ? gfx_set(0.40,0.85,0.95,1) :
  i==4 ? gfx_set(0.50,0.90,0.50,1) :
  i==5 ? gfx_set(0.90,0.45,0.90,1) :
         gfx_set(0.62,0.62,0.62,1);
);
function moutname(i dst) (
  i==0 ? strcpy(dst,"OFF") : i==1 ? strcpy(dst,"NOTE") : strcpy(dst,"CC");
);
function modename(i dst) (
  i==0 ? strcpy(dst,"FWD") : i==1 ? strcpy(dst,"REV") : i==2 ? strcpy(dst,"LOOP") : strcpy(dst,"PP");
);

function btn(x y w h lab on) local(hit r) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  on ? gfx_set(0.85,0.35,0.30,1) : hit ? gfx_set(0.32,0.34,0.38,1) : gfx_set(0.24,0.26,0.29,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.5,0.52,0.55,1);
  gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1); gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  gfx_set(0.92,0.93,0.94,1);
  gfx_measurestr(lab, btw, bth);
  gfx_x = x + (w-btw)/2; gfx_y = y + (h-bth)/2;
  gfx_drawstr(lab);
  r = hit && lclick;
  r;
);

function ufield(id x y w h lo hi def isenum val lab disp) local(hit nv tw th) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  hit && lclick ? (
    dbl ? (
      val = def;
    ) : isenum ? (
      val = val+1 > hi ? lo : val+1;
    ) : (
      fld_active = id; fld_v0 = val; fld_y0 = mouse_y;
    );
  );
  fld_active == id && (mouse_cap & 1) ? (
    nv = fld_v0 + (fld_y0 - mouse_y) * (hi-lo) / 160 * ((mouse_cap & 4) ? 0.1 : 1);
    val = min(hi, max(lo, nv));
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  fld_active == id ? gfx_set(0.30,0.36,0.44,1) : gfx_set(0.22,0.24,0.27,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.42,0.44,0.48,1);
  gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1); gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  gfx_set(0.55,0.58,0.62,1);
  gfx_x = x+4; gfx_y = y+2;
  gfx_drawstr(lab);
  gfx_set(0.93,0.94,0.95,1);
  gfx_measurestr(disp, tw, th);
  gfx_x = x + w - tw - 4; gfx_y = y + h - th - 2;
  gfx_drawstr(disp);
  val;
);

gfx_setfont(1, "Arial", 12);
W = gfx_w; H = gfx_h;

// drag-and-drop: file dropped onto the plugin window loads into current deck
!drop_req && gfx_getdropfile(0, #droppath) > 0 ? (
  drop_req = 1;
  gfx_getdropfile(-1);
);

lclick = (mouse_cap & 1) && !(last_cap & 1);
rclick = (mouse_cap & 2) && !(last_cap & 2);
dbl = 0;
lclick ? (
  tnow = time_precise();
  (tnow - lc_time < 0.32 && abs(mouse_x - lc_x) < 5 && abs(mouse_y - lc_y) < 5) ? dbl = 1;
  lc_time = tnow; lc_x = mouse_x; lc_y = mouse_y;
);

// ------- background chunked tasks (detect / classify / overview) -------
auto_det_req && task == 0 ? (
  auto_det_req = 0;
  task = 1; tsk_d = auto_det_d; det_new = 1;
);
task == 1 ? ( // transient detect on deck tsk_d
  det_new ? (
    det_new = 0;
    dk_nsl[tsk_d] = 0;
    tk_buf = dbuf(tsk_d);
    tk_sb = slb(tsk_d);
    det_i = 0; det_env = 0; det_slow = 0.001;
    det_hp = 0;
    det_last = -srate;
    det_gap = floor(0.05 * dk_srate[tsk_d]);
    det_fast = exp(-1/(0.003*dk_srate[tsk_d]));
    det_slowc = 1 - exp(-1/(0.08*dk_srate[tsk_d]));
    det_khp = 1 - exp(-2*$pi*3000/dk_srate[tsk_d]);
    det_thr = 1.2 + (1 - sens) * 6;
    det_bwin = floor(0.015 * dk_srate[tsk_d]);
    det_pre = floor(preroll_ms * 0.001 * dk_srate[tsk_d]);
  );
  det_n = min(det_i + 262144, dk_frames[tsk_d]);
  while (det_i < det_n) (
    dxm = (tk_buf[det_i*2] + tk_buf[det_i*2+1]) * 0.5;
    det_hp += (dxm - det_hp) * det_khp;
    // HF-weighted onset signal: broadband + emphasized high band (hats/snaps)
    dx = abs(tk_buf[det_i*2]) + abs(tk_buf[det_i*2+1]) + 3*abs(dxm - det_hp);
    det_env = max(dx, det_env * det_fast);
    det_slow += (det_env - det_slow) * det_slowc;
    (det_env > det_slow * det_thr && det_env > 0.01 &&
     det_i - det_last > det_gap && dk_nsl[tsk_d] < MAXSL) ? (
      // backtrack to the quietest point in the attack window
      bt0 = max(0, det_i - det_bwin);
      det_last >= 0 ? bt0 = max(bt0, det_last + 64);
      btmin = 1000000000; btpos = det_i;
      bti = bt0;
      while (bti <= det_i) (
        btv = abs(tk_buf[bti*2]) + abs(tk_buf[bti*2+1]);
        btv < btmin ? ( btmin = btv; btpos = bti; );
        bti += 1;
      );
      tk_sb[OF_START+dk_nsl[tsk_d]] = max(det_last >= 0 ? det_last + 64 : 0, btpos - det_pre);
      slice_defaults(tsk_d, dk_nsl[tsk_d]);
      dk_nsl[tsk_d] += 1;
      det_last = det_i;
      det_slow = det_env;
    );
    det_i += 1;
  );
  det_i >= dk_frames[tsk_d] ? (
    calc_ends(tsk_d);
    dk_sel[tsk_d] = dk_nsl[tsk_d] > 0 ? 0 : -1;
    task = 0;
  );
) : task == 2 ? ( // classify slices on deck tsk_d
  cls_new ? (
    cls_new = 0; cls_s = 0; cls_inslice = 0;
    tk_buf = dbuf(tsk_d);
    tk_sb = slb(tsk_d);
  );
  cls_s >= dk_nsl[tsk_d] ? task = 0 : (
    !cls_inslice ? (
      cls_inslice = 1;
      cls_i = tk_sb[OF_START+cls_s];
      cls_lp = 0; cls_lp2 = 0;
      cls_el = 0; cls_eh = 0; cls_et = 0.000000001;
      cls_peak = 0.000000001; cls_lastloud = cls_i;
      cls_klo = 1 - exp(-2*$pi*180/dk_srate[tsk_d]);
      cls_khi = 1 - exp(-2*$pi*4500/dk_srate[tsk_d]);
    );
    cls_n = min(cls_i + 262144, tk_sb[OF_END+cls_s]);
    while (cls_i < cls_n) (
      cmm = (tk_buf[cls_i*2] + tk_buf[cls_i*2+1]) * 0.5;
      cls_lp += (cmm - cls_lp) * cls_klo;
      cls_lp2 += (cmm - cls_lp2) * cls_khi;
      chh = cmm - cls_lp2;
      cls_el += cls_lp*cls_lp;
      cls_eh += chh*chh;
      cls_et += cmm*cmm;
      caa = abs(cmm);
      caa > cls_peak ? cls_peak = caa;
      caa > cls_peak * 0.05 ? cls_lastloud = cls_i;
      cls_i += 1;
    );
    cls_i >= tk_sb[OF_END+cls_s] ? (
      rl = cls_el / cls_et;
      rh = cls_eh / cls_et;
      dlen = (cls_lastloud - tk_sb[OF_START+cls_s]) / dk_srate[tsk_d];
      cc = rl > 0.4 ? 1 :
           (rh > 0.45 && dlen < 0.18) ? 3 :
           (rh > 0.35 && dlen > 0.35) ? 5 :
           (rh < 0.45 && rl < 0.4 && dlen < 0.45) ? 2 : 4;
      tk_sb[OF_CLASS+cls_s] = cc;
      cc == 3 ? tk_sb[OF_CHOKE+cls_s] = 1;  // hats auto-choke
      cls_inslice = 0;
      cls_s += 1;
    );
  );
) : task == 3 ? ( // rebuild overviews after project load
  ov_d > 1 ? task = 0 : (
    dk_frames[ov_d] <= 0 ? ( ov_d += 1; ov_i = 0; ) : (
      tk_buf = dbuf(ov_d);
      tk_ovb = OVW0 + ov_d*OVWST;
      ov_klo = 1 - exp(-2*$pi*200/max(dk_srate[ov_d],1));
      ov_khi = 1 - exp(-2*$pi*4000/max(dk_srate[ov_d],1));
      ov_n = min(ov_i + 262144, dk_frames[ov_d]);
      while (ov_i < ov_n) (
        (ov_i & (BINSZ-1)) == 0 ? ( ovmin = 1; ovmax = -1; ov_el = 0; ov_em = 0; ov_eh = 0; );
        cmm = (tk_buf[ov_i*2] + tk_buf[ov_i*2+1]) * 0.5;
        cmm > ovmax ? ovmax = cmm;
        cmm < ovmin ? ovmin = cmm;
        ov_lp += (cmm - ov_lp) * ov_klo;
        ov_lp2 += (cmm - ov_lp2) * ov_khi;
        ov_el += ov_lp*ov_lp;
        ov_em += (ov_lp2 - ov_lp)*(ov_lp2 - ov_lp);
        ov_eh += (cmm - ov_lp2)*(cmm - ov_lp2);
        ((ov_i & (BINSZ-1)) == (BINSZ-1) || ov_i == dk_frames[ov_d]-1) ? (
          tk_ovp = tk_ovb + floor(ov_i/BINSZ)*5;
          tk_ovp[0] = ovmin; tk_ovp[1] = ovmax;
          tk_ovp[2] = ov_el; tk_ovp[3] = ov_em; tk_ovp[4] = ov_eh;
        );
        ov_i += 1;
      );
      ov_i >= dk_frames[ov_d] ? ( ov_d += 1; ov_i = 0; );
    );
  );
);

// ---------------- layout ----------------
WX = 8;
WW = W - 16;
WY = 58;
WH = max(80, floor(H * 0.30));
PY = WY + WH + 8;
padw = floor(WW / 16);
padh = 26;
PH = padh*4 + 6;
PRY = PY + PH + 8;
gsel = dk_sel[cur];
gsb = slb(cur);
gfr = dk_frames[cur];
govw = OVW0 + cur*OVWST;

gfx_set(0.12,0.125,0.13,1);
gfx_rect(0,0,W,H);

// ---------------- toolbar row 1: decks + transport ----------------
bx = 8;
btn(bx, 2, 30, 22, "A", cur == 0) ? ( cur = 0; );
bx += 32;
btn(bx, 2, 30, 22, "B", cur == 1) ? ( cur = 1; );
bx += 40;
btn(bx, 2, 46, 22, "REC", capturing) ? (
  capturing ? finish_capture() : (
    task == 0 ? ( rec_d = cur; armed = 1; capturing = 1; wr = 0; binmin = 1; binmax = -1; );
  );
);
bx += 52;
btn(bx, 2, 52, 22, "ARM", armed && !capturing) ? (
  armed && !capturing ? armed = 0 : (
    task == 0 && !capturing ? ( rec_d = cur; armed = 1; );
  );
);
bx += 58;
btn(bx, 2, 62, 22, "DETECT", task == 1) && gfr > 0 && task == 0 ? ( task = 1; tsk_d = cur; det_new = 1; );
bx += 68;
btn(bx, 2, 68, 22, "CLASSIFY", task == 2) && dk_nsl[cur] > 0 && task == 0 ? ( task = 2; tsk_d = cur; cls_new = 1; );
bx += 74;
btn(bx, 2, 52, 22, "CLEAR", 0) ? ( dk_nsl[cur] = 0; dk_sel[cur] = -1; );
bx += 58;
btn(bx, 2, 72, 22, "MARKERS", 0) && gmem[0] == MAGIC ? import_markers(cur);
bx += 78;
btn(bx, 2, 46, 22, "AUTO", auto_det) ? auto_det = !auto_det;
bx += 52;
btn(bx, 2, 22, 22, "<", 0) ? (
  cur ? gfb_req = max(0, slider21 - 1) : gfa_req = max(0, slider20 - 1);
);
bx += 24;
btn(bx, 2, 22, 22, ">", 0) ? (
  cur ? gfb_req = min(1023, slider21 + 1) : gfa_req = min(1023, slider20 + 1);
);
bx += 28;

gfx_set(0.55,0.58,0.62,1);
gfx_x = bx + 4; gfx_y = 7;
capturing ? (
  sprintf(#info, "REC %s %.2fs", rec_d ? "B" : "A", wr/srate);
) : armed ? (
  sprintf(#info, "armed %s - waiting for audio/transport", rec_d ? "B" : "A");
) : gfr > 0 ? (
  sprintf(#info, "%s: file %d  %d Hz  %.2fs  %d slices", cur ? "B" : "A",
          cur ? slider21 : slider20, dk_srate[cur], gfr/max(dk_srate[cur],1), dk_nsl[cur]);
) : (
  sprintf(#info, "%s: empty - pick a file with < > (Data/jf_slixer) or REC/ARM", cur ? "B" : "A");
);
gfx_drawstr(#info);

midi_act ? (
  gfx_set(0.4,0.9,0.5,1);
  gfx_circle(W-14, 13, 5, 1);
  midi_act = 0;
);

// ---------------- toolbar row 2: presets + out mode + crossfader ----------------
gfx_set(0.55,0.58,0.62,1);
gfx_x = 8; gfx_y = 33;
gfx_drawstr("PRESET");
psx = 58;
gpi = 0;
while (gpi < 8) (
  ppx = psx + gpi*24;
  ppp = PRE + (cur*8+gpi)*1024;
  pflag = ppp[0];
  phit = mouse_x >= ppx && mouse_x < ppx+22 && mouse_y >= 28 && mouse_y < 50;
  pflag ? gfx_set(0.30,0.42,0.34,1) : gfx_set(0.20,0.22,0.25,1);
  phit ? gfx_set(0.36,0.40,0.46,1);
  gfx_rect(ppx, 28, 22, 22);
  gfx_set(0.5,0.52,0.55,1);
  gfx_rect(ppx,28,22,1); gfx_rect(ppx,49,22,1); gfx_rect(ppx,28,1,22); gfx_rect(ppx+21,28,1,22);
  gfx_set(0.9,0.91,0.92,1);
  gfx_x = ppx+7; gfx_y = 32;
  sprintf(#pn, "%d", gpi+1);
  gfx_drawstr(#pn);
  phit && lclick ? (
    (mouse_cap & 8) ? preset_save(cur, gpi) :
    (mouse_cap & 16) ? preset_clear(cur, gpi) :
    preset_load(cur, gpi);
  );
  gpi += 1;
);
psx += 8*24 + 10;
btn(psx, 28, 76, 22, outmode < 0.5 ? "OUT: MIX" : "OUT: SPLIT", 0) ? outmode = !outmode;
psx += 82;
btn(psx, 28, 92, 22,
    dk_sync[cur] == 0 ? "SYNC: OFF" : dk_sync[cur] == 1 ? "SYNC: PITCH" : "SYNC: STR",
    dk_sync[cur] > 0) ? (
  dk_sync[cur] = dk_sync[cur] + 1 > 2 ? 0 : dk_sync[cur] + 1;
);
psx += 98;

// crossfader
xfx = psx + 16; xfw = W - xfx - 24;
xfw > 60 ? (
  gfx_set(0.55,0.58,0.62,1);
  gfx_x = psx; gfx_y = 33; gfx_drawstr("A");
  gfx_x = xfx + xfw + 6; gfx_y = 33; gfx_drawstr("B");
  gfx_set(0.20,0.22,0.25,1);
  gfx_rect(xfx, 34, xfw, 10);
  gfx_set(0.5,0.52,0.55,1);
  gfx_rect(xfx,34,xfw,1); gfx_rect(xfx,43,xfw,1);
  hx = xfx + xfade*xfw;
  gfx_set(0.9,0.75,0.35,1);
  gfx_rect(hx-4, 29, 8, 20);
  (lclick && mouse_x >= xfx-6 && mouse_x < xfx+xfw+6 && mouse_y >= 27 && mouse_y < 51) ? xf_drag = 1;
  xf_drag && (mouse_cap & 1) ? (
    xfade = min(1, max(0, (mouse_x - xfx)/xfw));
    dbl ? xfade = 0.5;
  );
  xf_drag && !(mouse_cap & 1) ? xf_drag = 0;
);

// ---------------- waveform (current deck) ----------------
gfx_set(0.16,0.165,0.175,1);
gfx_rect(WX, WY, WW, WH);

fr_show = (capturing && rec_d == cur) ? wr : gfr;
fr_show > 0 ? (
  wmid = WY + WH/2;
  gsel >= 0 && gsel < dk_nsl[cur] ? (
    x0 = WX + gsb[OF_START+gsel]/fr_show * WW;
    x1 = WX + gsb[OF_END+gsel]/fr_show * WW;
    gfx_set(0.25,0.30,0.38,0.45);
    gfx_rect(x0, WY, max(1, x1-x0), WH);
  );
  cx = 0;
  totbins = max(1, floor(fr_show/BINSZ));
  while (cx < WW) (
    b0 = floor(cx / WW * totbins);
    b1 = max(b0+1, floor((cx+1) / WW * totbins));
    pmn = 1; pmx = -1; sel_ = 0; sem_ = 0; seh_ = 0;
    bb = b0;
    while (bb < b1) (
      gob = govw + bb*5;
      gob[0] < pmn ? pmn = gob[0];
      gob[1] > pmx ? pmx = gob[1];
      sel_ += gob[2]; sem_ += gob[3]; seh_ += gob[4];
      bb += 1;
    );
    pmx >= pmn ? (
      // media-explorer style spectral peaks: hue from spectral centroid
      set_ = sel_ + sem_ + seh_;
      set_ > 0 ? (
        ctr = (sem_*0.5 + seh_) / set_;
        ctr < 0.35 ? ( tt = ctr/0.35;        cr = 1;            cg2 = 0.15+0.65*tt; cb = 0.10; )
        : ctr < 0.6 ? ( tt = (ctr-0.35)/0.25; cr = 1-0.75*tt;    cg2 = 0.85;         cb = 0.10+0.25*tt; )
        : ctr < 0.8 ? ( tt = (ctr-0.6)/0.2;   cr = 0.25-0.15*tt; cg2 = 0.85;         cb = 0.35+0.55*tt; )
        :             ( tt = (ctr-0.8)/0.2;   cr = 0.10+0.35*tt; cg2 = 0.85-0.45*tt; cb = 0.92; );
        gfx_set(cr, cg2, cb, 1);
      ) : gfx_set(0.4, 0.42, 0.45, 1);
      y0 = wmid - pmx * (WH/2 - 2);
      y1 = wmid - pmn * (WH/2 - 2);
      gfx_line(WX+cx, y0, WX+cx, max(y1, y0+1));
    );
    cx += 1;
  );
  // alternating slice zone tint - makes the cut structure obvious
  gsi = 0;
  while (gsi < dk_nsl[cur]) (
    (gsi & 1) ? (
      x0 = WX + gsb[OF_START+gsi]/fr_show * WW;
      x1 = WX + gsb[OF_END+gsi]/fr_show * WW;
      gfx_set(1,1,1,0.06);
      gfx_rect(x0, WY, max(1, x1-x0), WH);
    );
    gsi += 1;
  );
  // slice markers
  gsi = 0;
  while (gsi < dk_nsl[cur]) (
    gmx = WX + gsb[OF_START+gsi]/fr_show * WW;
    classcol(gsb[OF_CLASS+gsi]);
    gfx_line(gmx, WY, gmx, WY+WH);
    gfx_triangle(gmx, WY, gmx+7, WY, gmx, WY+9);
    gsi == gsel ? (
      gfx_set(1,1,1,0.9);
      gfx_line(gmx+1, WY, gmx+1, WY+WH);
    );
    gfx_x = gmx+3; gfx_y = WY + WH - 14;
    gfx_set(0.7,0.72,0.75,1);
    sprintf(#sn, "%d", gsi+1);
    gfx_drawstr(#sn);
    gsi += 1;
  );
  // voice playheads
  gvi = 0;
  while (gvi < NVOICE) (
    gv = V0 + cur*1024 + gvi*VF;
    gv[fA] ? (
      php = (gsb[OF_FX+gv[fS]] == 2 || dk_sync[cur] == 2) ? gv[fVT] : gv[fPOS];
      gpx = WX + php/fr_show * WW;
      gfx_set(1,1,1,0.35 + 0.5*gv[fENV]);
      gfx_line(gpx, WY, gpx, WY+WH);
    );
    gvi += 1;
  );
);

// waveform mouse interaction
m_inwave = mouse_x >= WX && mouse_x < WX+WW && mouse_y >= WY && mouse_y < WY+WH;
m_fr = (mouse_x - WX) / WW * max(fr_show,1);
m_inwave && lclick && fr_show > 0 && !capturing ? (
  hitm = -1; gsi = 0;
  while (gsi < dk_nsl[cur]) (
    abs(WX + gsb[OF_START+gsi]/fr_show*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  (mouse_cap & 16) && hitm >= 0 ? (      // alt+click = delete
    del_slice(cur, hitm);
  ) : dbl ? (
    add_slice(cur, m_fr);
  ) : hitm >= 0 ? (
    drag_marker = hitm+1; dk_sel[cur] = hitm;
  ) : (
    gsi = 0;
    while (gsi < dk_nsl[cur]) (
      gsb[OF_START+gsi] <= m_fr ? dk_sel[cur] = gsi;
      gsi += 1;
    );
  );
);
rclick && m_inwave && fr_show > 0 ? (
  hitm = -1; gsi = 0;
  while (gsi < dk_nsl[cur]) (
    abs(WX + gsb[OF_START+gsi]/fr_show*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  hitm >= 0 ? del_slice(cur, hitm);
);
drag_marker > 0 && (mouse_cap & 1) ? (
  di = drag_marker - 1;
  dlo = di > 0 ? gsb[OF_START+di-1] + 64 : 0;
  dhi = di < dk_nsl[cur]-1 ? gsb[OF_START+di+1] - 64 : gfr - 64;
  gsb[OF_START+di] = max(dlo, min(dhi, floor(m_fr)));
  calc_ends(cur);
);
drag_marker > 0 && !(mouse_cap & 1) ? drag_marker = 0;

// ---------------- pads (current deck) ----------------
gbase = cur ? basenote_b : basenote_a;
gpi = 0;
while (gpi < MAXSL) (
  prow = floor(gpi/16); pcol = gpi % 16;
  gpx = WX + pcol*padw; gpy = PY + prow*(padh+2);
  gpi < dk_nsl[cur] ? (
    classcol(gsb[OF_CLASS+gpi]);
    gpi == gsel ? gfx_a = 1 : gfx_a = 0.55;
    gfx_rect(gpx, gpy, padw-2, padh);
    gvi = 0;
    while (gvi < NVOICE) (
      gv = V0 + cur*1024 + gvi*VF;
      gv[fA] && gv[fS] == gpi ? (
        php = (gsb[OF_FX+gpi] == 2 || dk_sync[cur] == 2) ? gv[fVT] : gv[fPOS];
        prg = (php - gsb[OF_START+gpi]) / max(1, gsb[OF_END+gpi] - gsb[OF_START+gpi]);
        gfx_set(1,1,1,0.9);
        gfx_rect(gpx, gpy + padh - 3, max(1,(padw-2) * min(1,prg)), 3);
      );
      gvi += 1;
    );
    gfx_set(0.08,0.08,0.09,1);
    gfx_x = gpx+3; gfx_y = gpy+2;
    sprintf(#pn, "%d", gpi+1);
    gfx_drawstr(#pn);
    gfx_x = gpx+3; gfx_y = gpy+padh-14;
    sprintf(#pn, "%d", gbase+gpi);
    gfx_drawstr(#pn);
    lclick && mouse_x >= gpx && mouse_x < gpx+padw-2 && mouse_y >= gpy && mouse_y < gpy+padh ? (
      dk_sel[cur] = gpi;
      pv_deck = cur;
      pv_req = gpi;
    );
  ) : (
    gfx_set(0.17,0.175,0.185,1);
    gfx_rect(gpx, gpy, padw-2, padh);
  );
  gpi += 1;
);

// ---------------- selected slice params ----------------
gsel = dk_sel[cur];
gsel >= 0 && gsel < dk_nsl[cur] ? (
  fw = floor((WW - 10) / 6);
  fh = 30;
  fy = PRY;
  fx0 = WX;

  sprintf(#d, "%.1f st", gsb[OF_PITCH+gsel]);
  gsb[OF_PITCH+gsel] = ufield(1, fx0, fy, fw-4, fh, -24, 24, 0, 0, gsb[OF_PITCH+gsel], "PITCH", #d);
  sprintf(#d, "%.1f dB", gsb[OF_GAIN+gsel]);
  gsb[OF_GAIN+gsel] = ufield(2, fx0+fw, fy, fw-4, fh, -24, 12, 0, 0, gsb[OF_GAIN+gsel], "GAIN", #d);
  sprintf(#d, "%d", floor(gsb[OF_PAN+gsel]*100+0.5));
  gsb[OF_PAN+gsel] = ufield(3, fx0+fw*2, fy, fw-4, fh, -1, 1, 0, 0, gsb[OF_PAN+gsel], "PAN", #d);
  fxname(gsb[OF_FX+gsel], #d);
  gsb[OF_FX+gsel] = ufield(4, fx0+fw*3, fy, fw-4, fh, 0, 8, 0, 1, gsb[OF_FX+gsel], "FX", #d);
  sprintf(#d, "%d%%", floor(gsb[OF_AMT+gsel]*100+0.5));
  gsb[OF_AMT+gsel] = ufield(5, fx0+fw*4, fy, fw-4, fh, 0, 1, 0.5, 0, gsb[OF_AMT+gsel], "AMT", #d);
  sprintf(#d, "%d%%", floor(gsb[OF_P2+gsel]*100+0.5));
  gsb[OF_P2+gsel] = ufield(6, fx0+fw*5, fy, fw-4, fh, 0, 1, 0.5, 0, gsb[OF_P2+gsel], "P2", #d);

  fy += fh + 4;
  fw7 = floor((WW - 10) / 7);
  modename(gsb[OF_MODE+gsel], #d);
  gsb[OF_MODE+gsel] = ufield(13, fx0, fy, fw7-4, fh, 0, 3, 0, 1, gsb[OF_MODE+gsel], "MODE", #d);
  classname(gsb[OF_CLASS+gsel], #d);
  gsb[OF_CLASS+gsel] = ufield(7, fx0+fw7, fy, fw7-4, fh, 0, 5, 0, 1, gsb[OF_CLASS+gsel], "CLASS", #d);
  sprintf(#d, "%d", gsb[OF_CHOKE+gsel]);
  gsb[OF_CHOKE+gsel] = floor(ufield(8, fx0+fw7*2, fy, fw7-4, fh, 0, 4, 0, 1, gsb[OF_CHOKE+gsel], "CHOKE", #d)+0.5);
  moutname(gsb[OF_MOUT+gsel], #d);
  gsb[OF_MOUT+gsel] = ufield(9, fx0+fw7*3, fy, fw7-4, fh, 0, 2, 0, 1, gsb[OF_MOUT+gsel], "OUT", #d);
  sprintf(#d, "%d", floor(gsb[OF_MNUM+gsel]+0.5));
  gsb[OF_MNUM+gsel] = floor(ufield(10, fx0+fw7*4, fy, fw7-4, fh, 0, 127, 36, 0, gsb[OF_MNUM+gsel], "NUM", #d)+0.5);
  sprintf(#d, "%d", floor(gsb[OF_MCHAN+gsel]+0.5)+1);
  gsb[OF_MCHAN+gsel] = floor(ufield(11, fx0+fw7*5, fy, fw7-4, fh, 0, 15, 0, 0, gsb[OF_MCHAN+gsel], "CHAN", #d)+0.5);
  sprintf(#d, "%d", floor(gsb[OF_MBUS+gsel]+0.5)+1);
  gsb[OF_MBUS+gsel] = floor(ufield(12, fx0+fw7*6, fy, fw7-4, fh, 0, 15, 0, 0, gsb[OF_MBUS+gsel], "BUS", #d)+0.5);
) : (
  gfx_set(0.4,0.42,0.45,1);
  gfx_x = WX; gfx_y = PRY + 8;
  gfx_drawstr("no slice selected - pick a file with < > (put WAVs in REAPER/Data/jf_slixer), or REC, then play pads via MIDI");
);

// ---------------- footer: global playback fields ----------------
fy2 = PRY + 30*2 + 12;
fy2 + 26 < H - 16 ? (
  fw2 = floor((WW - 10) / 8);
  strcpy(#d, monomode ? "MONO" : "POLY");
  monomode = ufield(20, WX, fy2, fw2-4, 26, 0, 1, 0, 1, monomode, "VOICES", #d);
  strcpy(#d, legato ? "ON" : "OFF");
  legato = ufield(21, WX+fw2, fy2, fw2-4, 26, 0, 1, 0, 1, legato, "LEGATO", #d);
  sprintf(#d, "%d ms", floor(glide_ms+0.5));
  glide_ms = ufield(22, WX+fw2*2, fy2, fw2-4, 26, 0, 500, 0, 0, glide_ms, "GLIDE", #d);
  strcpy(#d, interp < 0.5 ? "NONE" : interp < 1.5 ? "LIN" : "HERM");
  interp = ufield(23, WX+fw2*3, fy2, fw2-4, 26, 0, 2, 2, 1, interp, "INTERP", #d);
  strcpy(#d, gatemode ? "GATE" : "1-SHOT");
  gatemode = ufield(24, WX+fw2*4, fy2, fw2-4, 26, 0, 1, 0, 1, gatemode, "TRIG", #d);
  cur ? (
    sprintf(#d, "%d", floor(basenote_b+0.5));
    basenote_b = floor(ufield(25, WX+fw2*5, fy2, fw2-4, 26, 0, 127, 84, 0, basenote_b, "BASE B", #d)+0.5);
    gmch = mchb;
    gmch < 0.5 ? strcpy(#d, "OMNI") : sprintf(#d, "%d", floor(gmch+0.5));
    mchb = floor(ufield(26, WX+fw2*6, fy2, fw2-4, 26, 0, 16, 0, 1, mchb, "CH B", #d)+0.5);
  ) : (
    sprintf(#d, "%d", floor(basenote_a+0.5));
    basenote_a = floor(ufield(25, WX+fw2*5, fy2, fw2-4, 26, 0, 127, 36, 0, basenote_a, "BASE A", #d)+0.5);
    gmch = mcha;
    gmch < 0.5 ? strcpy(#d, "OMNI") : sprintf(#d, "%d", floor(gmch+0.5));
    mcha = floor(ufield(26, WX+fw2*6, fy2, fw2-4, 26, 0, 16, 0, 1, mcha, "CH A", #d)+0.5);
  );
  sprintf(#d, "%d ms", floor(preroll_ms+0.5));
  preroll_ms = floor(ufield(27, WX+fw2*7, fy2, fw2-4, 26, 0, 100, 5, 0, preroll_ms, "PREROLL", #d)+0.5);
);

gfx_set(0.38,0.40,0.43,1);
gfx_x = WX; gfx_y = H - 15;
gfx_drawstr("v0.6 | drop file here to load | wave: click=sel dbl=add drag=move alt/rclick=del | preset: click shift=save alt=clear | red=low green=mid blue=high");

task ? (
  gfx_set(0.9,0.8,0.3,1);
  gfx_x = W - 90; gfx_y = H - 15;
  gfx_drawstr(task == 1 ? "detecting..." : task == 2 ? "classifying..." : "rebuilding...");
);

last_cap = mouse_cap;
