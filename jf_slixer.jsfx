desc:jf_slixer - dual-deck transient slicer / pad sampler
//tags: sampler slicer drums
//author: jeeruff

options:maxmem=33554432
options:gmem=jf_slixer

slider1:sens=0.50<0.05,1,0.01>Transient sensitivity
slider2:basenote_a=36<0,127,1>Deck A base note
slider3:monomode=0<0,1,1{Poly,Mono}>Voice mode
slider4:legato=0<0,1,1{Off,On}>Legato
slider5:glide_ms=0<0,500,1>Glide (ms)
slider6:interp=2<0,2,1{None,Linear,Hermite}>Interpolation
slider7:gatemode=0<0,1,1{One-shot,Gate}>Trigger mode
slider8:mgain_db=0<-24,12,0.1>Master gain (dB)
slider9:caplen=8<1,120,1>Max capture (s)
slider10:saveaudio=1<0,1,1{No,Yes}>Save audio in project
slider11:thru=1<0,1,1{Off,On}>Input passthrough
slider12:xfade=0.5<0,1,0.001>Crossfade A-B
slider13:outmode=0<0,2,1{Mix on 1/2,Split A:1/2 B:3/4,Class buses 3-14}>Output routing
slider14:basenote_b=84<0,127,1>Deck B base note
slider15:mcha=0<0,16,1>Deck A MIDI channel (0=omni)
slider16:mchb=0<0,16,1>Deck B MIDI channel (0=omni)
slider17:preroll_ms=5<0,100,1>Slice pre-roll (ms)

in_pin:left
in_pin:right
out_pin:out 1 (A / mix L)
out_pin:out 2 (A / mix R)
out_pin:out 3 (B / bus1 L)
out_pin:out 4 (B / bus1 R)
out_pin:out 5 (bus2 L)
out_pin:out 6 (bus2 R)
out_pin:out 7 (bus3 L)
out_pin:out 8 (bus3 R)
out_pin:out 9 (bus4 L)
out_pin:out 10 (bus4 R)
out_pin:out 11 (bus5 L)
out_pin:out 12 (bus5 R)
out_pin:out 13 (bus6 L)
out_pin:out 14 (bus6 R)

@init
ext_noinit = 1;
ext_midi_bus = 1;

MAXSL   = 64;
NVOICE  = 16;
VF      = 40;
MAGIC   = 8888123;
BINSZ   = 256;

// memory map
busM    = 2900;               // 6 stereo class buses, 12 accumulators
OVR     = 2950;               // per-deck performance fx overrides (2 x 16)
qoff    = 3000;               // pending note-off queue, 32*3
dk_frames = 3200;             // per-deck scalars, index by deck 0/1
dk_srate  = 3204;
dk_nsl    = 3208;
dk_sel    = 3212;
dk_sync   = 3216;             // 0=off 1=repitch 2=stretch
SL0     = 4096;               // slice tables: deck stride 4096, field stride 64
V0      = 12288;              // voices: deck stride 1024 (16 * 40)
PRE     = 16384;              // presets: 16 slots (2 decks * 8) * 4096
SCR     = 81920;              // load scratch / legacy-convert buffer (32768 words)
OVW0    = 131072;             // overview bins: 5 words/bin (min,max,elo,emid,ehi)
OVWST   = 172032;             // per-deck overview stride
BUF0    = 475136;             // audio: stereo interleaved, deck stride below
DECKW   = (33554432 - BUF0) / 2;
DECKFR  = DECKW / 2;

// slice field offsets within deck slice base (33 fields, stride 64)
OF_START=0; OF_END=64; OF_PITCH=128; OF_GAIN=192; OF_PAN=256;
OF_CHOKE=320; OF_CLASS=384; OF_MOUT=448; OF_MNUM=512; OF_MCHAN=576;
OF_MBUS=640; OF_MODE=704; OF_OUTCH=768;
OF_FXA=832;    // 10 fx amounts: crush,stretch,comp,fm,am,ring,sat,down,stutter,glitch
OF_FXP=1472;   // 10 fx secondary params
NSLF = 33;
SLST = 4096;   // per-deck slice table stride
PRESLOT = 4096;

// voice fields
fA=0; fS=1; fPOS=2; fRATE=3; fTR=4; fENV=5; fST=6; fGL=7; fGR=8; fNOTE=9;
fVT=10; fPA=11; fPB=12; fPHA=13; fPHB=14; fBCC=15; fBHL=16; fBHR=17;
fPH1=18; fCEN=19; fEND=20; fVEL=21; fONOTE=22; fOCH=23; fOBUS=24;
fDIR=25; fSTART=26; fGRAN=27; fSATL=28; fSATR=29; fDNC=30; fDNL=31; fDNR=32;
fPH2=33; fPH3=34; fSTP=35; fSTC=36; fGLC=37; fGLP=38;

!initdone ? (
  initdone = 1;
  cur = 0;
  dk_sel[0] = -1; dk_sel[1] = -1;
  dk_srate[0] = srate; dk_srate[1] = srate;
  pv_req = -1; pv_deck = 0;
  fld_active = -1;
  task = 0;
  auto_det = 1;
  keysmode = 1;  // 0=chromatic, 1=white keys=slices / black keys=fx
);

function slb(d) ( SL0 + d*SLST );
function dbuf(d) ( BUF0 + d*DECKW );

function slice_defaults(d i) local(sb k) (
  sb = slb(d);
  sb[OF_PITCH+i]=0; sb[OF_GAIN+i]=0; sb[OF_PAN+i]=0;
  sb[OF_CHOKE+i]=0; sb[OF_CLASS+i]=0;
  sb[OF_MOUT+i]=0; sb[OF_MNUM+i]=36+i; sb[OF_MCHAN+i]=0; sb[OF_MBUS+i]=0;
  sb[OF_MODE+i]=0; sb[OF_OUTCH+i]=0;
  k = 0;
  while (k < 10) (
    sb[OF_FXA+k*64+i] = k == 1 ? 0.5 : 0;  // stretch neutral, rest off
    sb[OF_FXP+k*64+i] = 0.5;
    k += 1;
  );
);

function sort_slices(d) local(sb i j k p t) (
  sb = slb(d);
  i = 1;
  while (i < dk_nsl[d]) (
    j = i;
    while (j > 0 && sb[OF_START+j-1] > sb[OF_START+j]) (
      k = 0;
      while (k < NSLF) (
        p = sb + k*64 + j;
        t = p[-1]; p[-1] = p[0]; p[0] = t;
        k += 1;
      );
      j -= 1;
    );
    i += 1;
  );
);

function calc_ends(d) local(sb i) (
  sort_slices(d);
  sb = slb(d);
  i = 0;
  while (i < dk_nsl[d]) (
    sb[OF_END+i] = i < dk_nsl[d]-1 ? sb[OF_START+i+1] : dk_frames[d];
    i += 1;
  );
);

function del_slice(d idx) local(sb j k p) (
  sb = slb(d);
  j = idx;
  while (j < dk_nsl[d]-1) (
    k = 0;
    while (k < NSLF) (
      p = sb + k*64 + j;
      p[0] = p[1];
      k += 1;
    );
    j += 1;
  );
  dk_nsl[d] -= 1;
  dk_sel[d] >= dk_nsl[d] ? dk_sel[d] = dk_nsl[d]-1;
  calc_ends(d);
);

function add_slice(d fr) local(sb i) (
  sb = slb(d);
  dk_nsl[d] < MAXSL && dk_frames[d] > 0 ? (
    fr = max(0, min(dk_frames[d]-64, floor(fr)));
    sb[OF_START+dk_nsl[d]] = fr;
    slice_defaults(d, dk_nsl[d]);
    dk_nsl[d] += 1;
    calc_ends(d);
    i = 0; dk_sel[d] = 0;
    while (i < dk_nsl[d]) ( sb[OF_START+i] == fr ? dk_sel[d] = i; i += 1; );
  );
);

function import_markers(d) local(sb n i p) (
  sb = slb(d);
  n = min(gmem[2], MAXSL);
  dk_frames[d] > 0 && n > 0 ? (
    dk_nsl[d] = 0;
    i = 0;
    while (i < n) (
      p = floor(gmem[8+i] * dk_srate[d]);
      p >= 0 && p < dk_frames[d] ? (
        sb[OF_START+dk_nsl[d]] = p;
        slice_defaults(d, dk_nsl[d]);
        dk_nsl[d] += 1;
      );
      i += 1;
    );
    calc_ends(d);
    dk_sel[d] = dk_nsl[d] > 0 ? 0 : -1;
  );
);

function preset_save(d slot) local(p) (
  p = PRE + (d*8+slot)*PRESLOT;
  p[0] = 1;
  p[1] = dk_nsl[d];
  memcpy(p+16, slb(d), NSLF*64);
);

function preset_load(d slot) local(p i sb) (
  p = PRE + (d*8+slot)*PRESLOT;
  sb = slb(d);
  p[0] ? (
    memcpy(sb, p+16, NSLF*64);
    dk_nsl[d] = p[1];
    i = dk_nsl[d]-1;
    while (i >= 0) (
      sb[OF_START+i] >= max(dk_frames[d],64) ? del_slice(d, i);
      i -= 1;
    );
    calc_ends(d);
    dk_sel[d] = dk_nsl[d] > 0 ? min(max(dk_sel[d],0), dk_nsl[d]-1) : -1;
  );
);

function preset_clear(d slot) local(p) (
  p = PRE + (d*8+slot)*PRESLOT;
  p[0] = 0;
);

function qpush(v) (
  qn < 32 ? (
    q = qoff + qn*3;
    q[0] = v[fOBUS]; q[1] = v[fOCH]; q[2] = v[fONOTE]-1;
    qn += 1;
  );
  v[fONOTE] = 0;
);

// advance boundary handling: fidx = fPOS or fVT; mode 0=fwd 1=rev 2=loop 3=pingpong
function wrap_pos(v fidx mode) local(p st en) (
  p = v[fidx]; st = v[fSTART]; en = v[fEND];
  mode == 2 ? (
    p >= en ? p = st + (en - st > 1 ? p - en : 0);
  ) : mode == 3 ? (
    p >= en ? ( v[fDIR] = -1; p = max(st, 2*en - p - 1); );
    p <= st ? ( v[fDIR] = 1; p = min(en, 2*st - p); );
  ) : mode == 1 ? (
    p <= st ? v[fST] = 3;
  ) : (
    p >= en ? v[fST] = 3;
  );
  v[fidx] = p;
);

// audio-thread read; cd_buf / cd_frames must be set for the deck first
function readsmp(pos ch) local(i f a b c d c1 c2 c3) (
  pos < 1 ? pos = 1;
  pos > cd_frames-3 ? pos = cd_frames-3;
  interp < 0.5 ? (
    cd_buf[floor(pos+0.5)*2+ch];
  ) : interp < 1.5 ? (
    i = floor(pos); f = pos - i;
    a = cd_buf[i*2+ch];
    a + (cd_buf[i*2+2+ch] - a) * f;
  ) : (
    i = floor(pos); f = pos - i;
    a = cd_buf[(i-1)*2+ch]; b = cd_buf[i*2+ch];
    c = cd_buf[(i+1)*2+ch]; d = cd_buf[(i+2)*2+ch];
    c1 = 0.5*(c-a);
    c2 = a - 2.5*b + 2*c - 0.5*d;
    c3 = 0.5*(d-a) + 1.5*(b-c);
    ((c3*f + c2)*f + c1)*f + b;
  );
);

function trigger_slice(d s vel note ofs) local(sb vb vi v cg tr vol pl pr leg was best bi stp) (
  sb = slb(d); vb = V0 + d*1024;
  s >= 0 && s < dk_nsl[d] && dk_frames[d] > 0 && sb[OF_START+s] < sb[OF_END+s] ? (
    cg = sb[OF_CHOKE+s];
    cg ? (
      vi = 0;
      while (vi < NVOICE) (
        v = vb + vi*VF;
        v[fA] && sb[OF_CHOKE+v[fS]] == cg ? v[fST] = 3;
        vi += 1;
      );
    );
    monomode ? (
      vi = 0;
    ) : (
      bi = -1; best = 2; vi = 0;
      while (vi < NVOICE) (
        v = vb + vi*VF;
        v[fA] == 0 ? ( bi = vi; vi = NVOICE; )
        : ( v[fENV] <= best ? ( best = v[fENV]; bi = vi; ); vi += 1; );
      );
      vi = bi;
    );
    v = vb + vi*VF;
    v[fA] && v[fONOTE] ? qpush(v);
    was = v[fA] && v[fST] != 3;
    leg = monomode && legato && was;
    tr = pow(2, sb[OF_PITCH+s]/12) * (dk_srate[d] > 0 ? dk_srate[d]/srate : 1);
    v[fTR] = tr;
    v[fRATE] = (monomode && glide_ms > 0 && was) ? v[fRATE] : tr;
    v[fS] = s; v[fEND] = sb[OF_END+s]; v[fSTART] = sb[OF_START+s];
    v[fDIR] = sb[OF_MODE+s] == 1 ? -1 : 1;
    stp = sb[OF_MODE+s] == 1 ? sb[OF_END+s] - 2 : sb[OF_START+s];
    v[fPOS] = stp; v[fVT] = stp;
    v[fPA] = stp; v[fPB] = stp;
    v[fPHA] = 0; v[fPHB] = 0.5;
    leg ? 0 : (
      v[fENV] = v[fA] ? v[fENV] : 0;
      v[fST] = 1;
    );
    vol = pow(10, sb[OF_GAIN+s]/20) * (vel/127);
    pl = min(1, 1 - sb[OF_PAN+s]); pr = min(1, 1 + sb[OF_PAN+s]);
    v[fGL] = vol*pl; v[fGR] = vol*pr;
    v[fBCC] = 0; v[fBHL] = 0; v[fBHR] = 0; v[fPH1] = 0; v[fCEN] = 0;
    v[fSATL] = 0; v[fSATR] = 0; v[fDNC] = 0; v[fDNL] = 0; v[fDNR] = 0;
    v[fPH2] = 0; v[fPH3] = 0; v[fSTP] = 0; v[fSTC] = 0; v[fGLC] = 0; v[fGLP] = 0;
    v[fGRAN] = -1;  // re-resolve playback path on first sample
    v[fNOTE] = note; v[fVEL] = vel;
    v[fA] = 1;
    sb[OF_MOUT+s] == 1 ? (
      midi_bus = sb[OF_MBUS+s];
      midisend(ofs, $x90 | sb[OF_MCHAN+s], sb[OF_MNUM+s], vel);
      v[fONOTE] = sb[OF_MNUM+s]+1; v[fOCH] = sb[OF_MCHAN+s]; v[fOBUS] = sb[OF_MBUS+s];
    ) : sb[OF_MOUT+s] == 2 ? (
      midi_bus = sb[OF_MBUS+s];
      midisend(ofs, $xB0 | sb[OF_MCHAN+s], sb[OF_MNUM+s], vel);
      v[fONOTE] = 0;
    ) : v[fONOTE] = 0;
  );
);

// black key -> performance fx index: C#=stutter D#=glitch F#=crush G#=down A#=ring
function blackfx(pc) (
  pc == 1 ? 8 : pc == 3 ? 9 : pc == 6 ? 0 : pc == 8 ? 7 : 5;
);

// note -> slice index (>=0), black-key fx (-1000-pc), or -1
function map_note(d note) local(base rel oct pc) (
  base = d ? basenote_b : basenote_a;
  keysmode < 0.5 ? (
    note - base;
  ) : (
    rel = note - base;
    rel < 0 ? -1 : (
      oct = floor(rel/12); pc = rel - oct*12;
      (pc==1 || pc==3 || pc==6 || pc==8 || pc==10) ? (
        -1000 - pc;
      ) : (
        oct*7 + (pc==0?0 : pc==2?1 : pc==4?2 : pc==5?3 : pc==7?4 : pc==9?5 : 6);
      );
    );
  );
);

// slice index -> trigger note (inverse of map_note for display)
function slice_note(d idx) local(base w) (
  base = d ? basenote_b : basenote_a;
  keysmode < 0.5 ? (
    base + idx;
  ) : (
    w = idx % 7;
    base + floor(idx/7)*12 + (w==0?0 : w==1?2 : w==2?4 : w==3?5 : w==4?7 : w==5?9 : 11);
  );
);

function handle_on(d note vel ofs) local(s ob) (
  s = map_note(d, note);
  s >= 0 ? (
    trigger_slice(d, s, vel, note, ofs);
  ) : s <= -1000 ? (
    ob = OVR + d*16;
    ob[blackfx(-1000 - s)] = vel/127;  // velocity = fx depth while held
  );
);

function handle_off(d note) local(s ob) (
  s = map_note(d, note);
  s <= -1000 ? (
    ob = OVR + d*16;
    ob[blackfx(-1000 - s)] = 0;
  );
);

function release_note(note) local(d vi v vb sbd md) (
  d = 0;
  while (d < 2) (
    vb = V0 + d*1024; sbd = slb(d);
    vi = 0;
    while (vi < NVOICE) (
      v = vb + vi*VF;
      v[fA] && v[fNOTE] == note ? (
        md = sbd[OF_MODE + v[fS]];
        // loop/pingpong always gate on note-off; others follow global TRIG
        (gatemode || md == 2 || md == 3) ? v[fST] = 3;
      );
      vi += 1;
    );
    d += 1;
  );
);

function kill_all() local(d vi v) (
  d = 0;
  while (d < 2) (
    vi = 0;
    while (vi < NVOICE) (
      v = V0 + d*1024 + vi*VF;
      v[fA] ? v[fST] = 3;
      vi += 1;
    );
    d += 1;
  );
);

function clone_a_to_b() local(sb i) (
  dk_frames[0] > 0 ? (
    memcpy(dbuf(1), dbuf(0), dk_frames[0]*2);
    memcpy(OVW0 + OVWST, OVW0, (floor(dk_frames[0]/BINSZ)+1)*5);
    memcpy(slb(1), slb(0), SLST);
    dk_frames[1] = dk_frames[0];
    dk_srate[1] = dk_srate[0];
    dk_nsl[1] = dk_nsl[0];
    dk_sel[1] = dk_nsl[1] > 0 ? 0 : -1;
    // spice deck B with fx
    sb = slb(1);
    i = 0;
    while (i < dk_nsl[1]) (
      rand(1) < 0.6  ? sb[OF_FXA+0*64+i] = 0.2 + rand(0.4);   // crush
      rand(1) < 0.5  ? sb[OF_FXA+7*64+i] = 0.2 + rand(0.5);   // down
      rand(1) < 0.35 ? sb[OF_FXA+5*64+i] = 0.2 + rand(0.4);   // ring
      rand(1) < 0.3  ? sb[OF_FXA+8*64+i] = 0.3 + rand(0.5);   // stutter
      rand(1) < 0.25 ? sb[OF_FXA+9*64+i] = 0.3 + rand(0.5);   // glitch
      sb[OF_FXA+6*64+i] = 0.15 + rand(0.35);                  // sat on everything
      rand(1) < 0.2  ? sb[OF_MODE+i] = 1;                     // some reversed
      i += 1;
    );
  );
);

// convert pre-v5 slice tables (old layout in SCR) to the fx-chain layout
function conv_old_slices(d nf) local(sb i e a p k) (
  sb = slb(d);
  memset(sb, 0, SLST);
  i = 0;
  while (i < 64) (
    sb[OF_START+i] = SCR[i];
    sb[OF_END+i]   = SCR[64+i];
    sb[OF_PITCH+i] = SCR[128+i];
    sb[OF_GAIN+i]  = SCR[192+i];
    sb[OF_PAN+i]   = SCR[256+i];
    sb[OF_CHOKE+i] = SCR[512+i];
    sb[OF_CLASS+i] = SCR[576+i];
    sb[OF_MOUT+i]  = SCR[640+i];
    sb[OF_MNUM+i]  = SCR[704+i];
    sb[OF_MCHAN+i] = SCR[768+i];
    sb[OF_MBUS+i]  = SCR[832+i];
    sb[OF_MODE+i]  = nf >= 15 ? SCR[896+i] : 0;
    k = 0;
    while (k < 10) (
      sb[OF_FXA+k*64+i] = k == 1 ? 0.5 : 0;
      sb[OF_FXP+k*64+i] = 0.5;
      k += 1;
    );
    e = SCR[320+i]; a = SCR[384+i]; p = SCR[448+i];
    e == 2 ? (
      sb[OF_FXA+64+i] = (1 - log(pow(4, 1-2*a))/log(8))/2;
      sb[OF_FXP+64+i] = p;
    ) : (e >= 1 && e <= 8) ? (
      k = e == 1 ? 0 : e - 1;
      sb[OF_FXA+k*64+i] = a;
      sb[OF_FXP+k*64+i] = p;
    );
    i += 1;
  );
);

function finish_capture() local(b ob) (
  capturing = 0; armed = 0;
  dk_frames[rec_d] = wr;
  dk_srate[rec_d] = srate;
  wr > 0 && (wr & (BINSZ-1)) ? (
    b = floor(wr/BINSZ);
    ob = OVW0 + rec_d*OVWST + b*5;
    ob[0] = binmin; ob[1] = binmax;
    ob[2] = belo; ob[3] = bemid; ob[4] = behi;
  );
  dk_nsl[rec_d] > 0 ? calc_ends(rec_d);
  wr > 0 && auto_det ? ( auto_det_req = 1; auto_det_d = rec_d; );
);

function load_sample(d fs)
local(h nch fsr frames base chunkfr wrp n i scr l_ r_ cm_ ovp bmn bmx el em eh lp lp2 klo khi bi)
(
  h = file_open(fs);
  h > 0 ? (
    nch = 0; fsr = 0;
    file_riff(h, nch, fsr);
    nch > 0 && fsr > 0 ? (
      frames = min(floor(file_avail(h)/nch), DECKFR);
      frames > 0 ? (
        base = dbuf(d);
        ovp = OVW0 + d*OVWST;
        scr = SCR;
        chunkfr = max(1, floor(28672/nch));
        klo = 1 - exp(-2*$pi*200/fsr);
        khi = 1 - exp(-2*$pi*4000/fsr);
        bmn = 1; bmx = -1; el = 0; em = 0; eh = 0; lp = 0; lp2 = 0;
        wrp = 0;
        while (wrp < frames) (
          n = min(chunkfr, frames - wrp);
          file_mem(h, scr, n*nch);
          i = 0;
          while (i < n) (
            l_ = scr[i*nch];
            r_ = nch > 1 ? scr[i*nch+1] : l_;
            base[(wrp+i)*2] = l_;
            base[(wrp+i)*2+1] = r_;
            cm_ = (l_ + r_)*0.5;
            cm_ > bmx ? bmx = cm_;
            cm_ < bmn ? bmn = cm_;
            lp += (cm_ - lp)*klo;
            lp2 += (cm_ - lp2)*khi;
            el += lp*lp;
            em += (lp2 - lp)*(lp2 - lp);
            eh += (cm_ - lp2)*(cm_ - lp2);
            ( ((wrp+i) & (BINSZ-1)) == (BINSZ-1) || wrp+i == frames-1 ) ? (
              bi = ovp + floor((wrp+i)/BINSZ)*5;
              bi[0]=bmn; bi[1]=bmx; bi[2]=el; bi[3]=em; bi[4]=eh;
              bmn = 1; bmx = -1; el = 0; em = 0; eh = 0;
            );
            i += 1;
          );
          wrp += n;
        );
        dk_frames[d] = frames;
        dk_srate[d] = fsr;
        dk_nsl[d] = 0; dk_sel[d] = -1;
        auto_det ? ( auto_det_req = 1; auto_det_d = d; );
      );
    );
    file_close(h);
  );
);

@slider

@block
gmem[6] = cur;  // publish active deck for companion scripts

// dropped file from @gfx
drop_req ? (
  drop_req = 0;
  load_sample(cur, #droppath);
);

// ---- audio stream from jf_slixer_load_sample.lua (any file, any folder) ----
gmem[100] == 1 ? (  // header
  xh_d = gmem[101] > 0.5 ? 1 : 0;
  xh_sr = gmem[102];
  xh_total = min(gmem[103], DECKFR);
  xh_wr = 0;
  xh_sr > 0 && xh_total > 0 ? (
    xh_active = 1;
    xh_bmn = 1; xh_bmx = -1;
    xh_el = 0; xh_em = 0; xh_eh = 0;
    xh_lp = 0; xh_lp2 = 0;
    xh_klo = 1 - exp(-2*$pi*200/xh_sr);
    xh_khi = 1 - exp(-2*$pi*4000/xh_sr);
  ) : xh_active = 0;
  gmem[100] = 0;
) : gmem[100] == 2 && xh_active ? (  // chunk of interleaved stereo at gmem[16384]
  xn = gmem[104];
  xbase = dbuf(xh_d);
  xovp = OVW0 + xh_d*OVWST;
  xi = 0;
  while (xi < xn && xh_wr < xh_total) (
    xl = gmem[16384 + xi*2];
    xr = gmem[16384 + xi*2 + 1];
    xbase[xh_wr*2] = xl; xbase[xh_wr*2+1] = xr;
    xcm = (xl + xr)*0.5;
    xcm > xh_bmx ? xh_bmx = xcm;
    xcm < xh_bmn ? xh_bmn = xcm;
    xh_lp += (xcm - xh_lp)*xh_klo;
    xh_lp2 += (xcm - xh_lp2)*xh_khi;
    xh_el += xh_lp*xh_lp;
    xh_em += (xh_lp2 - xh_lp)*(xh_lp2 - xh_lp);
    xh_eh += (xcm - xh_lp2)*(xcm - xh_lp2);
    (xh_wr & (BINSZ-1)) == (BINSZ-1) ? (
      xp = xovp + floor(xh_wr/BINSZ)*5;
      xp[0]=xh_bmn; xp[1]=xh_bmx; xp[2]=xh_el; xp[3]=xh_em; xp[4]=xh_eh;
      xh_bmn = 1; xh_bmx = -1;
      xh_el = 0; xh_em = 0; xh_eh = 0;
    );
    xh_wr += 1; xi += 1;
  );
  gmem[100] = 0;
) : gmem[100] == 3 && xh_active ? (  // done
  xh_active = 0;
  xh_wr > 0 ? (
    (xh_wr & (BINSZ-1)) ? (
      xp = OVW0 + xh_d*OVWST + floor(xh_wr/BINSZ)*5;
      xp[0]=xh_bmn; xp[1]=xh_bmx; xp[2]=xh_el; xp[3]=xh_em; xp[4]=xh_eh;
    );
    dk_frames[xh_d] = xh_wr;
    dk_srate[xh_d] = xh_sr;
    dk_nsl[xh_d] = 0; dk_sel[xh_d] = -1;
    auto_det ? ( auto_det_req = 1; auto_det_d = xh_d; );
  );
  gmem[100] = 0;
);

mvol = pow(10, mgain_db/20);
gcoef = glide_ms <= 0 ? 1 : 1 - exp(-1/(glide_ms * 0.001 * srate));
atk_inc = 1 / max(1, 0.0015*srate);
rel_c = exp(-1/(0.004*srate));
klo_rec = 1 - exp(-2*$pi*200/srate);
khi_rec = 1 - exp(-2*$pi*4000/srate);
xga = cos(xfade * $pi * 0.5);
xgb = sin(xfade * $pi * 0.5);

// tempo-sync multipliers: fit deck length to nearest whole beats at project tempo
sm0 = 1; sm1 = 1;
smd = 0;
while (smd < 2) (
  dk_sync[smd] && dk_frames[smd] > 0 && dk_srate[smd] > 0 && tempo > 0 ? (
    smb = dk_frames[smd]/dk_srate[smd] * tempo / 60;
    smbi = max(1, floor(smb + 0.5));
    smd ? sm1 = smb/smbi : sm0 = smb/smbi;
  );
  smd += 1;
);

qi = 0;
while (qi < qn) (
  q = qoff + qi*3;
  midi_bus = q[0];
  midisend(0, $x80 | q[1], q[2], 0);
  qi += 1;
);
qn = 0;

gmem[0] == MAGIC && gmem[1] != g_serial ? (
  g_serial = gmem[1];
  !capturing ? import_markers(cur);
);

pv_req >= 0 ? (
  trigger_slice(pv_deck, pv_req, 100, -1, 0);
  pv_req = -1;
);

while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & $xF0;
  mch = m1 & $x0F;
  st == $x90 && m3 > 0 ? (
    (mcha == 0 || mch == mcha-1) ? handle_on(0, m2, m3, ofs);
    (mchb == 0 || mch == mchb-1) ? handle_on(1, m2, m3, ofs);
    midi_act = 1;
  ) : (st == $x80 || (st == $x90 && m3 == 0)) ? (
    (mcha == 0 || mch == mcha-1) ? handle_off(0, m2);
    (mchb == 0 || mch == mchb-1) ? handle_off(1, m2);
    release_note(m2);
  ) : st == $xD0 ? (
    // channel aftertouch -> realtime stretch depth per deck
    (mcha == 0 || mch == mcha-1) ? at0 = m2/127;
    (mchb == 0 || mch == mchb-1) ? at1 = m2/127;
  ) : st == $xB0 && m2 == 1 ? (
    // modwheel -> phase offset inside the slice per deck
    (mcha == 0 || mch == mcha-1) ? mw0 = m3/127;
    (mchb == 0 || mch == mchb-1) ? mw1 = m3/127;
  ) : st == $xB0 && (m2 == 123 || m2 == 120) ? (
    kill_all();
  );
  midisend(ofs, m1, m2, m3);
);

@sample
// capture into rec_d
armed ? (
  !capturing ? (
    (play_state & 1) || (abs(spl0) + abs(spl1) > 0.001) ? (
      capturing = 1; wr = 0;
      binmin = 1; binmax = -1;
      belo = 0; bemid = 0; behi = 0;
      rec_lp = 0; rec_lp2 = 0;
    );
  );
  capturing ? (
    maxfr = min(DECKFR, caplen * srate);
    wr < maxfr ? (
      rb = dbuf(rec_d);
      rb[wr*2] = spl0; rb[wr*2+1] = spl1;
      cm = (spl0 + spl1) * 0.5;
      cm > binmax ? binmax = cm;
      cm < binmin ? binmin = cm;
      rec_lp += (cm - rec_lp) * klo_rec;
      rec_lp2 += (cm - rec_lp2) * khi_rec;
      belo += rec_lp*rec_lp;
      bemid += (rec_lp2 - rec_lp)*(rec_lp2 - rec_lp);
      behi += (cm - rec_lp2)*(cm - rec_lp2);
      (wr & (BINSZ-1)) == (BINSZ-1) ? (
        rob = OVW0 + rec_d*OVWST + floor(wr/BINSZ)*5;
        rob[0] = binmin; rob[1] = binmax;
        rob[2] = belo; rob[3] = bemid; rob[4] = behi;
        binmin = 1; binmax = -1;
        belo = 0; bemid = 0; behi = 0;
      );
      wr += 1;
    ) : (
      finish_capture();
    );
  );
);

bi_ = 0;
while (bi_ < 12) ( busM[bi_] = 0; bi_ += 1; );

d_l0 = 0; d_r0 = 0; d_l1 = 0; d_r1 = 0;
dd = 0;
while (dd < 2) (
  cd_buf = dbuf(dd);
  cd_frames = dk_frames[dd];
  cd_sb = slb(dd);
  cd_vb = V0 + dd*1024;
  cd_sm = dd ? sm1 : sm0;
  cd_syncmode = dk_sync[dd];
  cd_at = dd ? at1 : at0;
  cd_mw = dd ? mw1 : mw0;
  cd_ov = OVR + dd*16;
  aol = 0; aor = 0;
  vi = 0;
  while (vi < NVOICE) (
    v = cd_vb + vi*VF;
    v[fA] ? (
      s = v[fS];
      smode = cd_sb[OF_MODE+s];
      v[fRATE] += (v[fTR] - v[fRATE]) * gcoef;
      rt = v[fRATE] * (cd_syncmode == 1 ? cd_sm : 1);
      sliceln = max(1, v[fEND] - v[fSTART]);
      voff = cd_mw * sliceln;  // modwheel phase offset

      // FM modulates the read position
      fma = cd_sb[OF_FXA+192+s];
      fma > 0.003 ? (
        v[fPH1] += 30*pow(2, cd_sb[OF_FXP+192+s]*7)/srate * 2*$pi;
        voff += sin(v[fPH1]) * fma*fma*400;
      );

      sta = cd_sb[OF_FXA+64+s];
      gran = abs(sta - 0.5) > 0.01 || cd_syncmode == 2 || cd_at > 0.003;
      gran != v[fGRAN] ? (
        // seamless path switch (e.g. aftertouch pressed mid-voice)
        v[fGRAN] = gran;
        gran ? (
          v[fVT] = v[fPOS]; v[fPA] = v[fPOS]; v[fPB] = v[fPOS];
          v[fPHA] = 0; v[fPHB] = 0.5;
        ) : v[fPOS] = v[fVT];
      );

      gran ? (
        // granular: 2 hann-windowed heads, timeline independent of pitch;
        // forced when deck sync is STRETCH or aftertouch is pressed
        spd = pow(8, 1 - 2*sta)
              * (dk_srate[dd] > 0 ? dk_srate[dd]/srate : 1)
              * (cd_syncmode ? cd_sm : 1)
              * pow(0.25, cd_at);
        glen = (0.02 + cd_sb[OF_FXP+64+s]*0.1) * srate;
        v[fVT] += spd * v[fDIR];
        wrap_pos(v, fVT, smode);
        v[fPA] += rt; v[fPB] += rt;
        v[fPHA] += 1/glen; v[fPHB] += 1/glen;
        v[fPHA] >= 1 ? (
          v[fPHA] -= 1;
          gpn = v[fVT] + voff;
          gpn >= v[fEND] ? gpn -= sliceln;
          gpn < v[fSTART] ? gpn += sliceln;
          v[fPA] = gpn;
        );
        v[fPHB] >= 1 ? (
          v[fPHB] -= 1;
          gpn = v[fVT] + voff;
          gpn >= v[fEND] ? gpn -= sliceln;
          gpn < v[fSTART] ? gpn += sliceln;
          v[fPB] = gpn;
        );
        wa = 0.5 - 0.5*cos(2*$pi*v[fPHA]);
        wb = 0.5 - 0.5*cos(2*$pi*v[fPHB]);
        l = readsmp(v[fPA],0)*wa + readsmp(v[fPB],0)*wb;
        r = readsmp(v[fPA],1)*wa + readsmp(v[fPB],1)*wb;
      ) : (
        rp = v[fPOS] + voff;
        rp >= v[fEND] ? rp -= sliceln;
        rp < v[fSTART] ? rp += sliceln;
        l = readsmp(rp,0); r = readsmp(rp,1);
        v[fPOS] += rt * v[fDIR];
        wrap_pos(v, fPOS, smode);
      );

      // ---- fx chain: all slots run at once; black keys push amounts up ----
      // glitch: random jump repeats (amt=probability, p2=interval)
      ga = max(cd_sb[OF_FXA+576+s], cd_ov[9]);
      ga > 0.003 ? (
        v[fGLC] -= 1;
        v[fGLC] <= 0 ? (
          v[fGLC] = (0.02 + cd_sb[OF_FXP+576+s]*0.2) * srate;
          v[fGLP] = rand(1) < ga ? floor(rand(sliceln)) : 0;
        );
        v[fGLP] > 0 ? (
          gp = (gran ? v[fVT] : v[fPOS]) + v[fGLP];
          gp >= v[fEND] ? gp -= sliceln;
          gp < v[fSTART] ? gp += sliceln;
          l = readsmp(gp,0); r = readsmp(gp,1);
        );
      );
      // stutter: loop a latched chunk (amt=mix, p2=loop length)
      ua = max(cd_sb[OF_FXA+512+s], cd_ov[8]);
      ua > 0.003 ? (
        stper = (0.01 + cd_sb[OF_FXP+512+s]*0.24) * srate;
        v[fSTC] <= 0 ? (
          v[fSTP] = gran ? v[fVT] : v[fPOS];
          v[fSTC] = stper;
        );
        v[fSTC] -= 1;
        sp_ = v[fSTP] + (stper - v[fSTC]) * rt;
        sp_ >= v[fEND] ? sp_ -= sliceln;
        sp_ < v[fSTART] ? sp_ += sliceln;
        l = l*(1-ua) + readsmp(sp_,0)*ua;
        r = r*(1-ua) + readsmp(sp_,1)*ua;
      ) : v[fSTC] = 0;
      // bitcrush
      ca = max(cd_sb[OF_FXA+0+s], cd_ov[0]);
      ca > 0.003 ? (
        v[fBCC] -= 1;
        v[fBCC] <= 0 ? (
          v[fBCC] = 1 + floor(cd_sb[OF_FXP+0+s]*31);
          qz = pow(2, 15 - ca*14);
          v[fBHL] = floor(l*qz + 0.5)/qz;
          v[fBHR] = floor(r*qz + 0.5)/qz;
        );
        l = v[fBHL]; r = v[fBHR];
      );
      // samplerate reduction
      da = max(cd_sb[OF_FXA+448+s], cd_ov[7]);
      da > 0.003 ? (
        v[fDNC] -= 1;
        v[fDNC] <= 0 ? (
          srstep = 1 + da*da*127;
          dp = cd_sb[OF_FXP+448+s];
          dp > 0 ? srstep *= 1 + (rand(2)-1)*dp*0.9;
          v[fDNC] += max(1, srstep);
          v[fDNL] = l; v[fDNR] = r;
        );
        l = v[fDNL]; r = v[fDNR];
      );
      // ringmod
      ra = max(cd_sb[OF_FXA+320+s], cd_ov[5]);
      ra > 0.003 ? (
        v[fPH3] += 30*pow(2, cd_sb[OF_FXP+320+s]*7)/srate * 2*$pi;
        rm = sin(v[fPH3]);
        l = l*(1-ra) + l*rm*ra;
        r = r*(1-ra) + r*rm*ra;
      );
      // AM/tremolo
      aa = cd_sb[OF_FXA+256+s];
      aa > 0.003 ? (
        v[fPH2] += 0.5*pow(2, cd_sb[OF_FXP+256+s]*11)/srate * 2*$pi;
        cg = 1 - aa*(0.5 + 0.5*sin(v[fPH2]));
        l *= cg; r *= cg;
      );
      // saturator
      sa = cd_sb[OF_FXA+384+s];
      sa > 0.003 ? (
        dv = 1 + sa*24;
        l = l*dv/(1 + abs(l*dv));
        r = r*dv/(1 + abs(r*dv));
        sp2 = cd_sb[OF_FXP+384+s];
        tc = 1 - exp(-2*$pi*(200 + sp2*sp2*18000)/srate);
        v[fSATL] += (l - v[fSATL])*tc;
        v[fSATR] += (r - v[fSATR])*tc;
        l = v[fSATL]; r = v[fSATR];
      );
      // compressor
      oa = cd_sb[OF_FXA+128+s];
      oa > 0.003 ? (
        ain = max(abs(l), abs(r));
        ain > v[fCEN] ? v[fCEN] += (ain - v[fCEN])*0.15
                      : v[fCEN] *= exp(-1/((0.03 + cd_sb[OF_FXP+128+s]*0.5)*srate));
        cg = v[fCEN] > 0.1 ? pow(v[fCEN]/0.1, -0.8*oa) : 1;
        cg *= 1 + oa*2.5;
        l *= cg; r *= cg;
      );

      v[fST] == 1 ? (
        v[fENV] += atk_inc;
        v[fENV] >= 1 ? ( v[fENV] = 1; v[fST] = 2; );
      ) : v[fST] == 3 ? (
        v[fENV] *= rel_c;
        v[fENV] < 0.001 ? (
          v[fA] = 0;
          v[fONOTE] ? qpush(v);
        );
      );
      oc = outmode > 1.5 ? cd_sb[OF_OUTCH+s] : 0;
      oc > 0 ? (
        bp = busM + (min(oc,6)-1)*2;
        bp[0] += l * v[fENV] * v[fGL];
        bp[1] += r * v[fENV] * v[fGR];
      ) : (
        aol += l * v[fENV] * v[fGL];
        aor += r * v[fENV] * v[fGR];
      );
    );
    vi += 1;
  );
  dd == 0 ? ( d_l0 = aol; d_r0 = aor; ) : ( d_l1 = aol; d_r1 = aor; );
  dd += 1;
);

outmode > 1.5 ? (
  // CLASS: mix on 1/2, per-class buses on 3-14 (crossfader still on mix)
  spl0 = spl0*thru + (d_l0*xga + d_l1*xgb)*mvol;
  spl1 = spl1*thru + (d_r0*xga + d_r1*xgb)*mvol;
  ob_ = 0;
  while (ob_ < 6) (
    spl(2 + ob_*2) = busM[ob_*2] * mvol;
    spl(3 + ob_*2) = busM[ob_*2+1] * mvol;
    ob_ += 1;
  );
) : outmode > 0.5 ? (
  spl0 = spl0*thru + d_l0*xga*mvol;
  spl1 = spl1*thru + d_r0*xga*mvol;
  spl2 = d_l1*xgb*mvol;
  spl3 = d_r1*xgb*mvol;
) : (
  spl0 = spl0*thru + (d_l0*xga + d_l1*xgb)*mvol;
  spl1 = spl1*thru + (d_r0*xga + d_r1*xgb)*mvol;
  spl2 = d_l1*xgb*mvol;
  spl3 = d_r1*xgb*mvol;
);

@serialize
srz_ver = 5;
file_var(0, srz_ver);
srz_wr = file_avail(0) < 0;
file_var(0, cur);
(srz_ver >= 3 || srz_wr) ? file_var(0, auto_det);
(srz_ver >= 5 || srz_wr) ? file_var(0, keysmode);
// per-deck scalars: frames, srate, nsl, sel (+sync from v4)
file_mem(0, 3200, (srz_ver >= 4 || srz_wr) ? 24 : 16);
srz_d = 0;
while (srz_d < 2) (
  srz_sb = slb(srz_d);
  (srz_ver >= 5 || srz_wr) ? (
    file_mem(0, srz_sb, NSLF*64);
  ) : (
    srz_n = srz_ver >= 4 ? 15 : 14;
    file_mem(0, SCR, srz_n*64);
    conv_old_slices(srz_d, srz_n);
  );
  file_avail(0) < 0 ? ( srz_aud = saveaudio && dk_frames[srz_d] > 0 ? 1 : 0; );
  file_var(0, srz_aud);
  srz_b = dbuf(srz_d);
  srz_aud ? file_mem(0, srz_b, dk_frames[srz_d]*2);
  srz_d += 1;
);
(srz_ver >= 5 || srz_wr) ? (
  file_mem(0, PRE, 16*PRESLOT);
) : (
  file_mem(0, SCR, 16*1024);   // old presets: incompatible layout, discarded
  memset(PRE, 0, 16*PRESLOT);
);
file_avail(0) >= 0 ? (
  dk_srate[0] <= 0 ? dk_srate[0] = srate;
  dk_srate[1] <= 0 ? dk_srate[1] = srate;
  (dk_frames[0] > 0 || dk_frames[1] > 0) ? ( task = 3; ov_d = 0; ov_i = 0; );
);

@gfx 860 560

function fxlabel(k dst) (
  k==0 ? strcpy(dst,"CRSH") : k==1 ? strcpy(dst,"STRC") : k==2 ? strcpy(dst,"COMP") :
  k==3 ? strcpy(dst,"FM")   : k==4 ? strcpy(dst,"AM")   : k==5 ? strcpy(dst,"RING") :
  k==6 ? strcpy(dst,"SAT")  : k==7 ? strcpy(dst,"DOWN") : k==8 ? strcpy(dst,"STUT") :
  strcpy(dst,"GLIT");
);
function classname(i dst) (
  i==0 ? strcpy(dst,"-") : i==1 ? strcpy(dst,"KICK") : i==2 ? strcpy(dst,"SNARE") :
  i==3 ? strcpy(dst,"HAT") : i==4 ? strcpy(dst,"PERC") : strcpy(dst,"CRASH");
);
function classcol(i) (
  i==1 ? gfx_set(0.91,0.36,0.18,1) :
  i==2 ? gfx_set(0.89,0.70,0.25,1) :
  i==3 ? gfx_set(0.43,0.77,0.85,1) :
  i==4 ? gfx_set(0.49,0.75,0.42,1) :
  i==5 ? gfx_set(0.73,0.56,0.85,1) :
         gfx_set(0.43,0.42,0.41,1);
);
function moutname(i dst) (
  i==0 ? strcpy(dst,"OFF") : i==1 ? strcpy(dst,"NOTE") : strcpy(dst,"CC");
);
function modename(i dst) (
  i==0 ? strcpy(dst,"FWD") : i==1 ? strcpy(dst,"REV") : i==2 ? strcpy(dst,"LOOP") : strcpy(dst,"PP");
);
function notename(n dst) local(pc oct) (
  n = floor(n + 0.5);
  pc = n % 12; oct = floor(n/12) - 1;
  pc==0  ? sprintf(dst,"C%d",oct)  : pc==1  ? sprintf(dst,"C#%d",oct) :
  pc==2  ? sprintf(dst,"D%d",oct)  : pc==3  ? sprintf(dst,"D#%d",oct) :
  pc==4  ? sprintf(dst,"E%d",oct)  : pc==5  ? sprintf(dst,"F%d",oct)  :
  pc==6  ? sprintf(dst,"F#%d",oct) : pc==7  ? sprintf(dst,"G%d",oct)  :
  pc==8  ? sprintf(dst,"G#%d",oct) : pc==9  ? sprintf(dst,"A%d",oct)  :
  pc==10 ? sprintf(dst,"A#%d",oct) : sprintf(dst,"B%d",oct);
);

// palette: three grays, class colors carry the code, one orange accent
function c_text()  ( gfx_set(0.92,0.90,0.88,1) );
function c_val()   ( gfx_set(0.78,0.76,0.74,1) );
function c_dim()   ( gfx_set(0.56,0.55,0.53,1) );
function c_faint() ( gfx_set(0.35,0.34,0.33,1) );
function c_hair()  ( gfx_set(0.17,0.17,0.17,1) );
function c_panel() ( gfx_set(0.105,0.105,0.11,1) );
function c_acc()   ( gfx_set(0.94,0.32,0.12,1) );

// flat text button: dim label, active = bright text + accent underline
function btn(x y w h lab on) local(hit) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  gfx_setfont(2);
  on ? c_text() : hit ? c_val() : c_dim();
  gfx_measurestr(lab, btw, bth);
  gfx_x = x + (w-btw)/2; gfx_y = y + (h-bth)/2 - 1;
  gfx_drawstr(lab);
  on ? ( c_acc(); gfx_rect(x, y+h-uln, w, uln); );
  hit && lclick;
);

// flat cell: small label, value below, left hairline; value tracks the
// pointer 1:1 within the frame, no easing; active = accent underline
function ufield(id x y w h lo hi def isenum val lab disp) local(hit nv) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  hit && lclick ? (
    dbl ? (
      val = def;
    ) : isenum ? (
      val = val+1 > hi ? lo : val+1;
    ) : (
      fld_active = id; fld_v0 = val; fld_y0 = mouse_y;
    );
  );
  fld_active == id && (mouse_cap & 1) ? (
    nv = fld_v0 + (fld_y0 - mouse_y) * (hi-lo) / 160 * ((mouse_cap & 4) ? 0.1 : 1);
    val = min(hi, max(lo, nv));
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  c_hair();
  gfx_rect(x, y, 1, h);
  gfx_setfont(3);
  c_faint();
  gfx_x = x + cpad; gfx_y = y + max(2, floor(3*scl));
  gfx_drawstr(lab);
  gfx_setfont(1);
  (fld_active == id || hit) ? c_text() : c_val();
  gfx_x = x + cpad; gfx_y = y + h - fs_val - max(3, floor(4*scl));
  gfx_drawstr(disp);
  fld_active == id ? ( c_acc(); gfx_rect(x, y+h-uln, w, uln); );
  val;
);

W = gfx_w; H = gfx_h;
scl = min(W/860, H/560);
scl = max(0.6, min(2.2, scl));
fs_val = max(10, floor(13*scl + 0.5));
fs_ctl = max(9,  floor(11*scl + 0.5));
fs_lab = max(8,  floor(9*scl + 0.5));
gfx_setfont(1, "Arial", fs_val);
gfx_setfont(2, "Arial", fs_ctl);
gfx_setfont(3, "Arial", fs_lab);
M = floor(12*scl);
uln = max(1, floor(2*scl));
cpad = max(5, floor(9*scl));

// drag-and-drop: file dropped onto the plugin window loads into current deck
!drop_req && gfx_getdropfile(0, #droppath) > 0 ? (
  drop_req = 1;
  gfx_getdropfile(-1);
);

lclick = (mouse_cap & 1) && !(last_cap & 1);
rclick = (mouse_cap & 2) && !(last_cap & 2);
dbl = 0;
lclick ? (
  tnow = time_precise();
  (tnow - lc_time < 0.32 && abs(mouse_x - lc_x) < 5 && abs(mouse_y - lc_y) < 5) ? dbl = 1;
  lc_time = tnow; lc_x = mouse_x; lc_y = mouse_y;
);

// ------- background chunked tasks (detect / classify / overview) -------
auto_det_req && task == 0 ? (
  auto_det_req = 0;
  task = 1; tsk_d = auto_det_d; det_new = 1;
);
task == 1 ? ( // transient detect on deck tsk_d
  det_new ? (
    det_new = 0;
    dk_nsl[tsk_d] = 0;
    tk_buf = dbuf(tsk_d);
    tk_sb = slb(tsk_d);
    det_i = 0; det_env = 0; det_slow = 0.001;
    det_hp = 0;
    det_last = -srate;
    det_gap = floor(0.05 * dk_srate[tsk_d]);
    det_fast = exp(-1/(0.003*dk_srate[tsk_d]));
    det_slowc = 1 - exp(-1/(0.08*dk_srate[tsk_d]));
    det_khp = 1 - exp(-2*$pi*3000/dk_srate[tsk_d]);
    det_thr = 1.2 + (1 - sens) * 6;
    det_bwin = floor(0.015 * dk_srate[tsk_d]);
    det_pre = floor(preroll_ms * 0.001 * dk_srate[tsk_d]);
  );
  det_n = min(det_i + 262144, dk_frames[tsk_d]);
  while (det_i < det_n) (
    dxm = (tk_buf[det_i*2] + tk_buf[det_i*2+1]) * 0.5;
    det_hp += (dxm - det_hp) * det_khp;
    // HF-weighted onset signal: broadband + emphasized high band (hats/snaps)
    dx = abs(tk_buf[det_i*2]) + abs(tk_buf[det_i*2+1]) + 3*abs(dxm - det_hp);
    det_env = max(dx, det_env * det_fast);
    det_slow += (det_env - det_slow) * det_slowc;
    (det_env > det_slow * det_thr && det_env > 0.01 &&
     det_i - det_last > det_gap && dk_nsl[tsk_d] < MAXSL) ? (
      // backtrack to the quietest point in the attack window
      bt0 = max(0, det_i - det_bwin);
      det_last >= 0 ? bt0 = max(bt0, det_last + 64);
      btmin = 1000000000; btpos = det_i;
      bti = bt0;
      while (bti <= det_i) (
        btv = abs(tk_buf[bti*2]) + abs(tk_buf[bti*2+1]);
        btv < btmin ? ( btmin = btv; btpos = bti; );
        bti += 1;
      );
      tk_sb[OF_START+dk_nsl[tsk_d]] = max(det_last >= 0 ? det_last + 64 : 0, btpos - det_pre);
      slice_defaults(tsk_d, dk_nsl[tsk_d]);
      dk_nsl[tsk_d] += 1;
      det_last = det_i;
      det_slow = det_env;
    );
    det_i += 1;
  );
  det_i >= dk_frames[tsk_d] ? (
    calc_ends(tsk_d);
    dk_sel[tsk_d] = dk_nsl[tsk_d] > 0 ? 0 : -1;
    task = 0;
  );
) : task == 2 ? ( // classify slices on deck tsk_d
  cls_new ? (
    cls_new = 0; cls_s = 0; cls_inslice = 0;
    tk_buf = dbuf(tsk_d);
    tk_sb = slb(tsk_d);
  );
  cls_s >= dk_nsl[tsk_d] ? task = 0 : (
    !cls_inslice ? (
      cls_inslice = 1;
      cls_i = tk_sb[OF_START+cls_s];
      cls_lp = 0; cls_lp2 = 0;
      cls_el = 0; cls_eh = 0; cls_et = 0.000000001;
      cls_peak = 0.000000001; cls_lastloud = cls_i;
      cls_klo = 1 - exp(-2*$pi*180/dk_srate[tsk_d]);
      cls_khi = 1 - exp(-2*$pi*4500/dk_srate[tsk_d]);
    );
    cls_n = min(cls_i + 262144, tk_sb[OF_END+cls_s]);
    while (cls_i < cls_n) (
      cmm = (tk_buf[cls_i*2] + tk_buf[cls_i*2+1]) * 0.5;
      cls_lp += (cmm - cls_lp) * cls_klo;
      cls_lp2 += (cmm - cls_lp2) * cls_khi;
      chh = cmm - cls_lp2;
      cls_el += cls_lp*cls_lp;
      cls_eh += chh*chh;
      cls_et += cmm*cmm;
      caa = abs(cmm);
      caa > cls_peak ? cls_peak = caa;
      caa > cls_peak * 0.05 ? cls_lastloud = cls_i;
      cls_i += 1;
    );
    cls_i >= tk_sb[OF_END+cls_s] ? (
      rl = cls_el / cls_et;
      rh = cls_eh / cls_et;
      dlen = (cls_lastloud - tk_sb[OF_START+cls_s]) / dk_srate[tsk_d];
      cc = rl > 0.4 ? 1 :
           (rh > 0.45 && dlen < 0.18) ? 3 :
           (rh > 0.35 && dlen > 0.35) ? 5 :
           (rh < 0.45 && rl < 0.4 && dlen < 0.45) ? 2 : 4;
      tk_sb[OF_CLASS+cls_s] = cc;
      tk_sb[OF_OUTCH+cls_s] = min(cc, 6);   // class bus: kick=1 snare=2 hat=3 perc=4 crash=5
      cc == 3 ? tk_sb[OF_CHOKE+cls_s] = 1;  // hats auto-choke
      cls_inslice = 0;
      cls_s += 1;
    );
  );
) : task == 3 ? ( // rebuild overviews after project load
  ov_d > 1 ? task = 0 : (
    dk_frames[ov_d] <= 0 ? ( ov_d += 1; ov_i = 0; ) : (
      tk_buf = dbuf(ov_d);
      tk_ovb = OVW0 + ov_d*OVWST;
      ov_klo = 1 - exp(-2*$pi*200/max(dk_srate[ov_d],1));
      ov_khi = 1 - exp(-2*$pi*4000/max(dk_srate[ov_d],1));
      ov_n = min(ov_i + 262144, dk_frames[ov_d]);
      while (ov_i < ov_n) (
        (ov_i & (BINSZ-1)) == 0 ? ( ovmin = 1; ovmax = -1; ov_el = 0; ov_em = 0; ov_eh = 0; );
        cmm = (tk_buf[ov_i*2] + tk_buf[ov_i*2+1]) * 0.5;
        cmm > ovmax ? ovmax = cmm;
        cmm < ovmin ? ovmin = cmm;
        ov_lp += (cmm - ov_lp) * ov_klo;
        ov_lp2 += (cmm - ov_lp2) * ov_khi;
        ov_el += ov_lp*ov_lp;
        ov_em += (ov_lp2 - ov_lp)*(ov_lp2 - ov_lp);
        ov_eh += (cmm - ov_lp2)*(cmm - ov_lp2);
        ((ov_i & (BINSZ-1)) == (BINSZ-1) || ov_i == dk_frames[ov_d]-1) ? (
          tk_ovp = tk_ovb + floor(ov_i/BINSZ)*5;
          tk_ovp[0] = ovmin; tk_ovp[1] = ovmax;
          tk_ovp[2] = ov_el; tk_ovp[3] = ov_em; tk_ovp[4] = ov_eh;
        );
        ov_i += 1;
      );
      ov_i >= dk_frames[ov_d] ? ( ov_d += 1; ov_i = 0; );
    );
  );
);

// ---------------- layout: heights scale from scl, widths fill from W ----------------
row1h = floor(24*scl);
row2h = floor(20*scl);
y1 = floor(8*scl);
y2 = y1 + row1h + floor(4*scl);
WX = M; WW = W - 2*M;
WY = y2 + row2h + floor(8*scl);
hinth = fs_lab + floor(7*scl);
footh = floor(30*scl);
cellh = floor(30*scl);
fxh   = floor(44*scl);
strh  = floor(24*scl);
padh  = floor(24*scl);
padgap = max(1, floor(2*scl));
padw = floor((WW - padgap*15) / 16);
PH = padh*4 + padgap*3;
foot_y = H - hinth - footh - floor(6*scl);
str_y = foot_y - floor(8*scl) - strh;
fx_y  = str_y - floor(4*scl) - fxh;
pr_y  = fx_y - floor(4*scl) - cellh;
PY = pr_y - floor(8*scl) - PH;
WH = max(40, PY - floor(8*scl) - WY);
gsel = dk_sel[cur];
gsb = slb(cur);
gfr = dk_frames[cur];
govw = OVW0 + cur*OVWST;

gfx_set(0.082,0.082,0.082,1);
gfx_rect(0,0,W,H);

// ---------------- row 1: decks, transport, actions ----------------
bx = M;
tabw = floor(24*scl);
btn(bx, y1, tabw, row1h, "A", cur == 0) ? cur = 0;
bx += tabw + floor(4*scl);
btn(bx, y1, tabw, row1h, "B", cur == 1) ? cur = 1;
bx += tabw + floor(12*scl);

// REC: dot + label
recw = floor(46*scl);
rhit = mouse_x >= bx && mouse_x < bx+recw && mouse_y >= y1 && mouse_y < y1+row1h;
rcy = y1 + row1h/2;
rcr = max(3, floor(4*scl));
c_acc();
gfx_circle(bx+rcr+1, rcy, rcr, capturing);
gfx_setfont(2);
capturing ? c_text() : rhit ? c_val() : c_dim();
gfx_x = bx + rcr*2 + floor(5*scl); gfx_y = rcy - fs_ctl/2 - 1;
gfx_drawstr("REC");
rhit && lclick ? (
  capturing ? finish_capture() : (
    task == 0 ? ( rec_d = cur; armed = 1; capturing = 1; wr = 0; binmin = 1; binmax = -1; );
  );
);
bx += recw + floor(8*scl);

aw = floor(36*scl);
btn(bx, y1, aw, row1h, "ARM", armed && !capturing) ? (
  armed && !capturing ? armed = 0 : (
    task == 0 && !capturing ? ( rec_d = cur; armed = 1; );
  );
);
bx += aw + floor(8*scl);
aw = floor(50*scl);
btn(bx, y1, aw, row1h, "DETECT", task == 1) && gfr > 0 && task == 0 ? ( task = 1; tsk_d = cur; det_new = 1; );
bx += aw + floor(8*scl);
aw = floor(60*scl);
btn(bx, y1, aw, row1h, "CLASSIFY", task == 2) && dk_nsl[cur] > 0 && task == 0 ? ( task = 2; tsk_d = cur; cls_new = 1; );
bx += aw + floor(8*scl);
aw = floor(42*scl);
btn(bx, y1, aw, row1h, "CLEAR", 0) ? ( dk_nsl[cur] = 0; dk_sel[cur] = -1; );
bx += aw + floor(8*scl);
aw = floor(60*scl);
btn(bx, y1, aw, row1h, "MARKERS", 0) && gmem[0] == MAGIC ? import_markers(cur);
bx += aw + floor(8*scl);
aw = floor(38*scl);
btn(bx, y1, aw, row1h, "AUTO", auto_det) ? auto_det = !auto_det;
bx += aw + floor(8*scl);
// LOAD/ITEM go through the background helper (jf_slixer_helper.lua)
gmem[8] != hb_last ? ( hb_last = gmem[8]; hb_t = time_precise(); );
helper_ok = time_precise() - hb_t < 2;
aw = floor(38*scl);
btn(bx, y1, aw, row1h, "LOAD", 0) ? (
  helper_ok ? gmem[7] = 1 : warn_t = time_precise();
);
bx += aw + floor(8*scl);
aw = floor(36*scl);
btn(bx, y1, aw, row1h, "ITEM", 0) ? (
  helper_ok ? gmem[7] = 2 : warn_t = time_precise();
);
bx += aw + floor(8*scl);

// status, right-aligned small; orange while MIDI is coming in
capturing ? (
  sprintf(#info, "REC %s  %.2f s", rec_d ? "B" : "A", wr/srate);
) : armed ? (
  sprintf(#info, "%s armed", rec_d ? "B" : "A");
) : gfr > 0 ? (
  sprintf(#info, "%s · %d Hz · %.2f s · %d slices", cur ? "B" : "A",
          dk_srate[cur], gfr/max(dk_srate[cur],1), dk_nsl[cur]);
) : (
  sprintf(#info, "%s · empty · LOAD / ITEM / drop / REC", cur ? "B" : "A");
);
gfx_setfont(3);
gfx_measurestr(#info, iw, ih);
W - M - iw > bx ? (
  midi_act ? c_acc() : c_dim();
  gfx_x = W - M - iw; gfx_y = y1 + (row1h-ih)/2;
  gfx_drawstr(#info);
);
midi_act = 0;

// ---------------- row 2: presets, out, sync, clone, keys, crossfader ----------------
gfx_setfont(3);
c_faint();
gfx_x = M; gfx_y = y2 + floor(5*scl);
gfx_drawstr("PRESET");
gfx_measurestr("PRESET", iw, ih);
psx = M + iw + floor(8*scl);
psz = floor(16*scl);
pgap = max(2, floor(4*scl));
psy = y2 + (row2h - psz)/2;
gpi = 0;
while (gpi < 8) (
  ppx = psx + gpi*(psz+pgap);
  ppp = PRE + (cur*8+gpi)*1024;
  phit = mouse_x >= ppx && mouse_x < ppx+psz && mouse_y >= psy && mouse_y < psy+psz;
  phit ? gfx_set(0.165,0.165,0.17,1) : gfx_set(0.12,0.12,0.125,1);
  gfx_rect(ppx, psy, psz, psz);
  ppp[0] ? (
    c_text();
    dsz = max(2, floor(4*scl));
    gfx_rect(ppx + (psz-dsz)/2, psy + (psz-dsz)/2, dsz, dsz);
  );
  phit && lclick ? (
    (mouse_cap & 8) ? preset_save(cur, gpi) :
    (mouse_cap & 16) ? preset_clear(cur, gpi) :
    preset_load(cur, gpi);
  );
  gpi += 1;
);
psx += 8*(psz+pgap) + floor(10*scl);

aw = floor(50*scl);
btn(psx, y2, aw, row2h,
    outmode < 0.5 ? "MIX" : outmode < 1.5 ? "SPLIT" : "CLASS", outmode > 1.5) ? (
  outmode = outmode + 1 > 2 ? 0 : outmode + 1;
);
psx += aw + floor(6*scl);
aw = floor(64*scl);
btn(psx, y2, aw, row2h,
    dk_sync[cur] == 0 ? "SYNC OFF" : dk_sync[cur] == 1 ? "SYNC PIT" : "SYNC STR",
    dk_sync[cur] > 0) ? (
  dk_sync[cur] = dk_sync[cur] + 1 > 2 ? 0 : dk_sync[cur] + 1;
);
psx += aw + floor(6*scl);
aw = floor(34*scl);
btn(psx, y2, aw, row2h, "A>B", 0) && task == 0 && !capturing ? clone_a_to_b();
psx += aw + floor(6*scl);
aw = floor(46*scl);
btn(psx, y2, aw, row2h, keysmode < 0.5 ? "CHROM" : "PIANO", keysmode > 0.5) ? keysmode = !keysmode;
psx += aw + floor(6*scl);

// crossfader: value = pointer position, same frame, no easing
xlw = floor(8*scl);
xfx = psx + xlw + floor(6*scl);
xfw = W - M - xlw - floor(6*scl) - xfx;
xfw > 50*scl ? (
  gfx_setfont(3);
  c_dim();
  gfx_x = psx; gfx_y = y2 + (row2h-fs_lab)/2;
  gfx_drawstr("A");
  gfx_x = xfx + xfw + floor(6*scl); gfx_y = y2 + (row2h-fs_lab)/2;
  gfx_drawstr("B");
  tky = y2 + row2h/2;
  c_hair();
  gfx_rect(xfx, tky, xfw, max(1,floor(2*scl)));
  hw = max(4, floor(8*scl));
  hh = floor(18*scl);
  c_text();
  gfx_rect(xfx + xfade*xfw - hw/2, tky - hh/2, hw, hh);
  (lclick && mouse_x >= xfx - hw && mouse_x < xfx+xfw+hw && mouse_y >= y2 - 4 && mouse_y < y2+row2h+4) ? xf_drag = 1;
  xf_drag && (mouse_cap & 1) ? (
    xfade = min(1, max(0, (mouse_x - xfx)/xfw));
    dbl ? xfade = 0.5;
  );
  xf_drag && !(mouse_cap & 1) ? xf_drag = 0;
);

// ---------------- waveform (current deck): spectral peaks ----------------
c_panel();
gfx_rect(WX, WY, WW, WH);
c_hair();
gfx_rect(WX, WY, WW, 1);
gfx_rect(WX, WY+WH-1, WW, 1);

fr_show = (capturing && rec_d == cur) ? wr : gfr;
fr_show > 0 ? (
  wmid = WY + WH/2;
  gsel >= 0 && gsel < dk_nsl[cur] ? (
    x0 = WX + gsb[OF_START+gsel]/fr_show * WW;
    x1 = WX + gsb[OF_END+gsel]/fr_show * WW;
    gfx_set(0.92,0.90,0.88,0.06);
    gfx_rect(x0, WY, max(1, x1-x0), WH);
  );
  cx = 0;
  totbins = max(1, floor(fr_show/BINSZ));
  while (cx < WW) (
    b0 = floor(cx / WW * totbins);
    b1 = max(b0+1, floor((cx+1) / WW * totbins));
    pmn = 1; pmx = -1; sel_ = 0; sem_ = 0; seh_ = 0;
    bb = b0;
    while (bb < b1) (
      gob = govw + bb*5;
      gob[0] < pmn ? pmn = gob[0];
      gob[1] > pmx ? pmx = gob[1];
      sel_ += gob[2]; sem_ += gob[3]; seh_ += gob[4];
      bb += 1;
    );
    pmx >= pmn ? (
      // media-explorer style spectral peaks: hue from spectral centroid
      set_ = sel_ + sem_ + seh_;
      set_ > 0 ? (
        ctr = (sem_*0.5 + seh_) / set_;
        ctr < 0.35 ? ( tt = ctr/0.35;        cr = 1;            cg2 = 0.15+0.65*tt; cb = 0.10; )
        : ctr < 0.6 ? ( tt = (ctr-0.35)/0.25; cr = 1-0.75*tt;    cg2 = 0.85;         cb = 0.10+0.25*tt; )
        : ctr < 0.8 ? ( tt = (ctr-0.6)/0.2;   cr = 0.25-0.15*tt; cg2 = 0.85;         cb = 0.35+0.55*tt; )
        :             ( tt = (ctr-0.8)/0.2;   cr = 0.10+0.35*tt; cg2 = 0.85-0.45*tt; cb = 0.92; );
        gfx_set(cr, cg2, cb, 1);
      ) : gfx_set(0.40,0.39,0.36,1);
      y0 = wmid - pmx * (WH/2 - 2);
      y1w = wmid - pmn * (WH/2 - 2);
      gfx_line(WX+cx, y0, WX+cx, max(y1w, y0+1));
    );
    cx += 1;
  );
  // alternating slice zone tint - makes the cut structure obvious
  gsi = 0;
  while (gsi < dk_nsl[cur]) (
    (gsi & 1) ? (
      x0 = WX + gsb[OF_START+gsi]/fr_show * WW;
      x1 = WX + gsb[OF_END+gsi]/fr_show * WW;
      gfx_set(1,1,1,0.05);
      gfx_rect(x0, WY, max(1, x1-x0), WH);
    );
    gsi += 1;
  );
  // slice markers: 2px class-color line + flag square + number/note at the bottom
  mkf = max(6, floor(8*scl));
  mkw = max(1, floor(2*scl));
  gsi = 0;
  while (gsi < dk_nsl[cur]) (
    gmx = WX + gsb[OF_START+gsi]/fr_show * WW;
    classcol(gsb[OF_CLASS+gsi]);
    gfx_rect(gmx, WY, mkw, WH);
    gfx_rect(gmx, WY, mkf, mkf);
    gsi == gsel ? (
      gfx_set(0.92,0.90,0.88,0.9);
      gfx_rect(gmx + mkw, WY, 1, WH);
    );
    gfx_setfont(3);
    c_dim();
    gfx_x = gmx + floor(4*scl); gfx_y = WY + WH - fs_lab - floor(4*scl);
    notename(slice_note(cur, gsi), #nn);
    sprintf(#sn, "%d %s", gsi+1, #nn);
    gfx_drawstr(#sn);
    gsi += 1;
  );
  // voice playheads, live position every frame
  gvi = 0;
  while (gvi < NVOICE) (
    gv = V0 + cur*1024 + gvi*VF;
    gv[fA] ? (
      php = (abs(gsb[OF_FXA+64+gv[fS]] - 0.5) > 0.01 || dk_sync[cur] == 2) ? gv[fVT] : gv[fPOS];
      gpx = WX + php/fr_show * WW;
      gfx_set(0.92,0.90,0.88, 0.3 + 0.55*gv[fENV]);
      gfx_line(gpx, WY, gpx, WY+WH);
    );
    gvi += 1;
  );
);

// waveform mouse interaction
m_inwave = mouse_x >= WX && mouse_x < WX+WW && mouse_y >= WY && mouse_y < WY+WH;
m_fr = (mouse_x - WX) / WW * max(fr_show,1);
m_inwave && lclick && fr_show > 0 && !capturing ? (
  hitm = -1; gsi = 0;
  while (gsi < dk_nsl[cur]) (
    abs(WX + gsb[OF_START+gsi]/fr_show*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  (mouse_cap & 16) && hitm >= 0 ? (      // alt+click = delete
    del_slice(cur, hitm);
  ) : dbl ? (
    add_slice(cur, m_fr);
  ) : hitm >= 0 ? (
    drag_marker = hitm+1; dk_sel[cur] = hitm;
  ) : (
    gsi = 0;
    while (gsi < dk_nsl[cur]) (
      gsb[OF_START+gsi] <= m_fr ? dk_sel[cur] = gsi;
      gsi += 1;
    );
  );
);
rclick && m_inwave && fr_show > 0 ? (
  hitm = -1; gsi = 0;
  while (gsi < dk_nsl[cur]) (
    abs(WX + gsb[OF_START+gsi]/fr_show*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  hitm >= 0 ? del_slice(cur, hitm);
);
drag_marker > 0 && (mouse_cap & 1) ? (
  di = drag_marker - 1;
  dlo = di > 0 ? gsb[OF_START+di-1] + 64 : 0;
  dhi = di < dk_nsl[cur]-1 ? gsb[OF_START+di+1] - 64 : gfr - 64;
  gsb[OF_START+di] = max(dlo, min(dhi, floor(m_fr)));
  calc_ends(cur);
);
drag_marker > 0 && !(mouse_cap & 1) ? drag_marker = 0;

// ---------------- pads: neutral squares, class color as a top bar ----------------
barh = max(2, floor(3*scl));
gpi = 0;
while (gpi < MAXSL) (
  prow = floor(gpi/16); pcol = gpi % 16;
  gpx = WX + pcol*(padw+padgap); gpy = PY + prow*(padh+padgap);
  gpi < dk_nsl[cur] ? (
    gpi == gsel ? (
      classcol(gsb[OF_CLASS+gpi]);
      gfx_rect(gpx, gpy, padw, padh);
    ) : (
      gfx_set(0.122,0.122,0.126,1);
      gfx_rect(gpx, gpy, padw, padh);
      classcol(gsb[OF_CLASS+gpi]);
      gfx_rect(gpx, gpy, padw, barh);
    );
    gvi = 0;
    while (gvi < NVOICE) (
      gv = V0 + cur*1024 + gvi*VF;
      gv[fA] && gv[fS] == gpi ? (
        php = (abs(gsb[OF_FXA+64+gpi] - 0.5) > 0.01 || dk_sync[cur] == 2) ? gv[fVT] : gv[fPOS];
        prg = (php - gsb[OF_START+gpi]) / max(1, gsb[OF_END+gpi] - gsb[OF_START+gpi]);
        gfx_set(0.92,0.90,0.88,0.95);
        gfx_rect(gpx, gpy + padh - max(1,floor(2*scl)), max(1, padw * min(1,prg)), max(1,floor(2*scl)));
      );
      gvi += 1;
    );
    gfx_setfont(3);
    gpi == gsel ? gfx_set(0.08,0.08,0.08,1) : c_dim();
    gfx_x = gpx + max(2,floor(3*scl)); gfx_y = gpy + barh + max(1,floor(2*scl));
    sprintf(#pn, "%d", gpi+1);
    gfx_drawstr(#pn);
    padh >= barh + fs_lab*2 + floor(6*scl) ? (
      gpi == gsel ? gfx_set(0.08,0.08,0.08,1) : c_faint();
      gfx_x = gpx + max(2,floor(3*scl)); gfx_y = gpy + padh - fs_lab - max(1,floor(2*scl));
      notename(slice_note(cur, gpi), #pn);
      gfx_drawstr(#pn);
    );
    lclick && mouse_x >= gpx && mouse_x < gpx+padw && mouse_y >= gpy && mouse_y < gpy+padh ? (
      dk_sel[cur] = gpi;
      pv_deck = cur;
      pv_req = gpi;
    );
  ) : (
    gfx_set(0.098,0.098,0.10,1);
    gfx_rect(gpx, gpy, padw, padh);
  );
  gpi += 1;
);

// ---------------- selected slice: params, fx chain, stretch/routing ----------------
c_hair();
gfx_rect(WX, pr_y - 1, WW, 1);
gfx_rect(WX, pr_y + cellh, WW, 1);
gsel = dk_sel[cur];
gsel >= 0 && gsel < dk_nsl[cur] ? (
  fw = floor(WW / 6);
  fy = pr_y;

  sprintf(#d, "%.1f st", gsb[OF_PITCH+gsel]);
  gsb[OF_PITCH+gsel] = ufield(1, WX, fy, fw, cellh, -24, 24, 0, 0, gsb[OF_PITCH+gsel], "PITCH", #d);
  sprintf(#d, "%.1f dB", gsb[OF_GAIN+gsel]);
  gsb[OF_GAIN+gsel] = ufield(2, WX+fw, fy, fw, cellh, -24, 12, 0, 0, gsb[OF_GAIN+gsel], "GAIN", #d);
  sprintf(#d, "%d", floor(gsb[OF_PAN+gsel]*100+0.5));
  gsb[OF_PAN+gsel] = ufield(3, WX+fw*2, fy, fw, cellh, -1, 1, 0, 0, gsb[OF_PAN+gsel], "PAN", #d);
  modename(gsb[OF_MODE+gsel], #d);
  gsb[OF_MODE+gsel] = ufield(13, WX+fw*3, fy, fw, cellh, 0, 3, 0, 1, gsb[OF_MODE+gsel], "MODE", #d);
  classname(gsb[OF_CLASS+gsel], #d);
  gsb[OF_CLASS+gsel] = ufield(7, WX+fw*4, fy, fw, cellh, 0, 5, 0, 1, gsb[OF_CLASS+gsel], "CLASS", #d);
  sprintf(#d, "%d", gsb[OF_CHOKE+gsel]);
  gsb[OF_CHOKE+gsel] = floor(ufield(8, WX+fw*5, fy, WW-fw*5, cellh, 0, 4, 0, 1, gsb[OF_CHOKE+gsel], "CHOKE", #d)+0.5);

  // fx chain: 10 flat mini sliders, left-drag=amount, right-drag=P2, dbl=reset
  fxgap = max(2, floor(3*scl));
  fxw = floor((WW - fxgap*9) / 10);
  fxlabh = fs_lab + floor(4*scl);
  fxk = 0;
  while (fxk < 10) (
    sx = WX + fxk*(fxw+fxgap); sy = fx_y;
    shit = mouse_x >= sx && mouse_x < sx+fxw && mouse_y >= sy && mouse_y < sy+fxh;
    shit && lclick ? (
      dbl ? (
        gsb[OF_FXA + fxk*64 + gsel] = fxk == 1 ? 0.5 : 0;
        gsb[OF_FXP + fxk*64 + gsel] = 0.5;
      ) : fxdrag = fxk+1;
    );
    shit && rclick ? fxrdrag = fxk+1;
    fxdrag == fxk+1 && (mouse_cap & 1) ? (
      gsb[OF_FXA + fxk*64 + gsel] = min(1, max(0, 1 - (mouse_y - sy - fxlabh)/(fxh - fxlabh - 2)));
    );
    fxdrag == fxk+1 && !(mouse_cap & 1) ? fxdrag = 0;
    fxrdrag == fxk+1 && (mouse_cap & 2) ? (
      gsb[OF_FXP + fxk*64 + gsel] = min(1, max(0, 1 - (mouse_y - sy - fxlabh)/(fxh - fxlabh - 2)));
    );
    fxrdrag == fxk+1 && !(mouse_cap & 2) ? fxrdrag = 0;
    sval = gsb[OF_FXA + fxk*64 + gsel];
    spv  = gsb[OF_FXP + fxk*64 + gsel];
    gfx_set(0.122,0.122,0.126,1);
    gfx_rect(sx, sy, fxw, fxh);
    fxact = fxk == 1 ? abs(sval - 0.5) > 0.01 : sval > 0.003;
    fh2 = (fxh - fxlabh - 2) * sval;
    fxact ? gfx_set(0.94,0.32,0.12,0.9) : gfx_set(0.35,0.34,0.33,0.5);
    gfx_rect(sx, sy + fxlabh + (fxh - fxlabh - 2) - fh2, fxw, fh2);
    gfx_set(0.92,0.90,0.88,0.75);
    gfx_rect(sx, sy + fxlabh + (fxh - fxlabh - 2)*(1 - spv), fxw, 1);
    gfx_setfont(3);
    fxact ? c_text() : c_dim();
    gfx_x = sx + max(2,floor(3*scl)); gfx_y = sy + max(1,floor(2*scl));
    fxlabel(fxk, #fl);
    gfx_drawstr(#fl);
    fxk += 1;
  );

  // stretch quick values + routing/midi-out
  gfx_setfont(3);
  c_faint();
  gfx_x = WX; gfx_y = str_y + (strh-fs_lab)/2;
  gfx_drawstr("STR");
  gfx_measurestr("STR", iw, ih);
  stx = WX + iw + floor(6*scl);
  stw = floor(28*scl);
  fxk = 0;
  while (fxk < 7) (
    sf = fxk==0?0.75 : fxk==1?0.5 : fxk==2?1 : fxk==3?1.5 : fxk==4?2 : fxk==5?4 : 8;
    strcpy(#fl, fxk==0?"3/4" : fxk==1?"1/2" : fxk==2?"1x" : fxk==3?"1.5" : fxk==4?"2x" : fxk==5?"4x" : "8x");
    stv = (1 + log(sf)/log(8)) / 2;
    btn(stx, str_y, stw, strh, #fl, abs(gsb[OF_FXA+64+gsel] - stv) < 0.01) ? (
      gsb[OF_FXA+64+gsel] = stv;
    );
    stx += stw + floor(3*scl);
    fxk += 1;
  );
  ox = stx + floor(8*scl);
  ow = floor((WX + WW - ox) / 5);
  ow > 30*scl ? (
    sprintf(#d, "%d", floor(gsb[OF_OUTCH+gsel]+0.5));
    gsb[OF_OUTCH+gsel] = floor(ufield(14, ox, str_y, ow, strh, 0, 6, 0, 1, gsb[OF_OUTCH+gsel], "BUS OUT", #d)+0.5);
    moutname(gsb[OF_MOUT+gsel], #d);
    gsb[OF_MOUT+gsel] = ufield(9, ox+ow, str_y, ow, strh, 0, 2, 0, 1, gsb[OF_MOUT+gsel], "MIDI", #d);
    sprintf(#d, "%d", floor(gsb[OF_MNUM+gsel]+0.5));
    gsb[OF_MNUM+gsel] = floor(ufield(10, ox+ow*2, str_y, ow, strh, 0, 127, 36, 0, gsb[OF_MNUM+gsel], "NUM", #d)+0.5);
    sprintf(#d, "%d", floor(gsb[OF_MCHAN+gsel]+0.5)+1);
    gsb[OF_MCHAN+gsel] = floor(ufield(11, ox+ow*3, str_y, ow, strh, 0, 15, 0, 0, gsb[OF_MCHAN+gsel], "CHAN", #d)+0.5);
    sprintf(#d, "%d", floor(gsb[OF_MBUS+gsel]+0.5)+1);
    gsb[OF_MBUS+gsel] = floor(ufield(12, ox+ow*4, str_y, WX+WW-ox-ow*4, strh, 0, 15, 0, 0, gsb[OF_MBUS+gsel], "BUS", #d)+0.5);
  );
) : (
  gfx_setfont(3);
  c_faint();
  gfx_x = WX + cpad; gfx_y = pr_y + cellh - fs_lab*2;
  gfx_drawstr("no slice selected - LOAD a file, ITEM (selected item), drop a file here, or REC, then play pads via MIDI");
);

// ---------------- footer: global playback fields ----------------
c_hair();
gfx_rect(WX, foot_y - 1, WW, 1);
gfx_rect(WX, foot_y + footh, WW, 1);
fw2 = floor(WW / 8);
strcpy(#d, monomode ? "MONO" : "POLY");
monomode = ufield(20, WX, foot_y, fw2, footh, 0, 1, 0, 1, monomode, "VOICES", #d);
strcpy(#d, legato ? "ON" : "OFF");
legato = ufield(21, WX+fw2, foot_y, fw2, footh, 0, 1, 0, 1, legato, "LEGATO", #d);
sprintf(#d, "%d ms", floor(glide_ms+0.5));
glide_ms = ufield(22, WX+fw2*2, foot_y, fw2, footh, 0, 500, 0, 0, glide_ms, "GLIDE", #d);
strcpy(#d, interp < 0.5 ? "NONE" : interp < 1.5 ? "LIN" : "HERM");
interp = ufield(23, WX+fw2*3, foot_y, fw2, footh, 0, 2, 2, 1, interp, "INTERP", #d);
strcpy(#d, gatemode ? "GATE" : "1-SHOT");
gatemode = ufield(24, WX+fw2*4, foot_y, fw2, footh, 0, 1, 0, 1, gatemode, "TRIG", #d);
cur ? (
  sprintf(#d, "%d", floor(basenote_b+0.5));
  basenote_b = floor(ufield(25, WX+fw2*5, foot_y, fw2, footh, 0, 127, 84, 0, basenote_b, "BASE B", #d)+0.5);
  mchb < 0.5 ? strcpy(#d, "OMNI") : sprintf(#d, "%d", floor(mchb+0.5));
  mchb = floor(ufield(26, WX+fw2*6, foot_y, fw2, footh, 0, 16, 0, 1, mchb, "CH B", #d)+0.5);
) : (
  sprintf(#d, "%d", floor(basenote_a+0.5));
  basenote_a = floor(ufield(25, WX+fw2*5, foot_y, fw2, footh, 0, 127, 36, 0, basenote_a, "BASE A", #d)+0.5);
  mcha < 0.5 ? strcpy(#d, "OMNI") : sprintf(#d, "%d", floor(mcha+0.5));
  mcha = floor(ufield(26, WX+fw2*6, foot_y, fw2, footh, 0, 16, 0, 1, mcha, "CH A", #d)+0.5);
);
sprintf(#d, "%d ms", floor(preroll_ms+0.5));
preroll_ms = floor(ufield(27, WX+fw2*7, foot_y, WW-fw2*7, footh, 0, 100, 5, 0, preroll_ms, "PREROLL", #d)+0.5);

// ---------------- hint ----------------
gfx_setfont(3);
gfx_x = WX; gfx_y = H - hinth;
warn_t > 0 && time_precise() - warn_t < 4 ? (
  c_acc();
  gfx_drawstr("helper off: run jf_slixer_helper.lua once (Actions) or restart REAPER for autostart");
) : (
  c_faint();
  gfx_drawstr("v1.0 | piano: white=slices, black: C#stut D#glit F#crush G#down A#ring | fx: drag=amt rdrag=P2 dbl=reset | wave: dbl add · alt del");
);

task ? (
  c_acc();
  sprintf(#d, "%s", task == 1 ? "detecting" : task == 2 ? "classifying" : "rebuilding");
  gfx_measurestr(#d, iw, ih);
  gfx_x = W - M - iw; gfx_y = H - hinth;
  gfx_drawstr(#d);
);

last_cap = mouse_cap;
